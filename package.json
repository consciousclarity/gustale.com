{
  "name": "gustale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source geo-located encyclopedia of dishes and ingredients",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check --max-diagnostics none --no-errors-on-unmatched .",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @gustale/db run generate",
    "db:migrate": "pnpm --filter @gustale/db run migrate",
    "db:seed": "pnpm --filter @gustale/db run seed",
    "smoke:map": "node scripts/hermes/smoke-map-pages.mjs",
    "smoke:map:summary": "node scripts/hermes/smoke-map-pages.mjs >/dev/null 2>&1; cat /tmp/snap/summary.json | python3 -c \"import json,sys; d=json.load(sys.stdin); print(f'{len(d)} shots, {sum(1 for s in d if s[\\\"failures\\\"])} failures')\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "inject-workspace-packages": [
      "*"
    ]
  }
}
