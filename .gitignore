# ─── Dependencies ─────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*
.yarn/
*.lockb

# ─── Build output ─────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ─── Backups / temp ───────────────────────────────────────────────────
*.bak
*.tmp
*.orig
*.rej
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Cache / coverage ────────────────────────────────────────────────
.cache/
.turbo/
.parcel-cache/
.eslintcache
*.lcov
coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ─── Secrets — NEVER commit these ────────────────────────────────────
# .env files (any depth, any name except .env.example)
.env
.env.*
!.env.example

# SSH / TLS / signing material
*.pem
*.key
*.crt
*.csr
id_rsa*
id_ed25519*
known_hosts*

# MinIO / S3 state
.minio-data/
.minio.sys/

# Postgres dumps
*.sql.gz
*.sql.bz2
*.dump

# ─── Tooling: Docker ─────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ─── Tooling: editor / OS ────────────────────────────────────────────
.swc/
*.swp
*.swo
*~
.fuse_hidden*

# ─── Repo-specific: monorepo build artifacts ─────────────────────────
# Database package: generated SQL and dist should be committed;
# .bak directories must NEVER be.
packages/db/dist/
packages/db/dist.bak/
packages/db/.drizzle-tmp/
# Dual-domain web build output (recipes variant) — local/CI only.
dist-recipes/
# Graphify analysis output — never commit generated graphs.
graphify-out/

# Test artefacts
apps/api/test/.tmp/
apps/api/test/__snapshots__/*.snap.tmp

# ─── Project notes (webmaster-only, not for git) ───────────────────
# project-data/ contains handoff dumps and personal notes. Do not commit.
project-data/
logs.zip

# .hermes/ contains agent-shared state files (SHARED_STATE.md, TASKS.md)
# and Hermes-specific notes. Keep local-only — Hermes syncs them out-of-band.
# CLAUDE.md (sibling) IS committed so Claude Code picks it up automatically.
.hermes/
*.log.zip
.swarm/
.claude-flow/
ruvector.db
*.ruvector.db
# Holds provider API keys in PLAINTEXT — never commit.
claude-flow.config.json
apps/api/deploy/

# ─── Hermes session handoff (webmaster-only, never commit) ──────────
# docs/session-handoff.md is written by the session-guard plugin when a
# session is frozen or reset. It contains live conversation excerpts and
# internal paths — this repo is PUBLIC, so it must stay local.
docs/session-handoff.md

# ADR-003 — the self-hosted Noto faces.
#
# The @font-face rules (apps/web/src/styles/noto.css) ARE committed,
# but the woff2 files are not: the CJK faces alone are tens of
# megabytes, and they are fetched at build time by
# scripts/fetch_noto_fonts.py.
apps/web/public/fonts/noto/

# Python bytecode
__pycache__/
*.pyc

# The generated cover-image plan and the Pool A description proposals.
# They are rebuilt by scripts/fetch_cover_images.py and
# scripts/rewrite_pool_a_descriptions.py, and the descriptions are
# published to the database, not to the repository.
data/cover_images.json
data/cover_images_poola.json
data/pool_a_descriptions.json

# The kanban workers' git worktrees.
#
# The recipes board creates one worktree per card, under .worktrees/.
# They are SEPARATE checkouts of this repo -- committing them would
# commit a nested repository, and `git add -A` from the main checkout
# would sweep them in. The workers branch from origin/main and push
# from inside their own worktree, so nothing here needs to be tracked.
.worktrees/

# Smoke test browser libraries (downloaded, not committed)
scripts/smoke/.browser-libs/

# The live snapshot cache (written by fetch-live-snapshot.mjs at build time).
# It is a BUILD ARTIFACT, not source: it maps each dish slug to its last
# fetch, so a rebuild that changed no dish skips the fetch entirely.
apps/web/scripts/.live-snapshot-cache.json

# The REAL live snapshot, written at build time by fetch-live-snapshot.mjs.
# It is 7 MB of live data and changes on every build, so it must never be
# committed. The committed PLACEHOLDER is
# apps/web/scripts/live-snapshot.placeholder.json; the build copies it into
# place at apps/web/scripts/live-snapshot.json before the docker build.
apps/web/scripts/live-snapshot.json

# The staging-only admin test account's SQL.
#
# It PROMOTES a real account to admin on the STAGING database, and it is
# a deployment script that runs against that database. It must never be
# committed: it names the test account, it is staging-specific, and a
# committed copy is one more copy of a credential-adjacent artefact to
# keep in sync with a database that gets reset.
#
# It is also gitignored so it cannot be swept in by a `git add -A`.
# The proof script that USES it is tracked:
# scripts/verify-staging-admin-lifecycle.sh.
#
# The DELETE counterpart (scripts/staging-admin-test-account-delete.sql)
# IS tracked on purpose: it holds no credential and no hash, it only
# removes the account and its sessions, and having it in the tree means
# the cleanup is reproducible after a database reset.
scripts/staging-admin-test-account.sql
