      "sentences": [
        {
          "id": "00000000-0000-0000-0000-00000000s001",
          "field": "intro",
          "locale": "en",
          "position": 1,
          "text": "Moussaka is layered rather than mixed: the aubergine, the minced meat and the béchamel are kept apart until the dish is assembled.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s002",
          "field": "step",
          "locale": "en",
          "position": 1,
          "text": "Slice the aubergines about a centimetre thick, salt them generously and leave them to drain for half an hour.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s003",
          "field": "step",
          "locale": "en",
          "position": 2,
          "text": "Fry the slices in batches until they are golden, then drain them on paper.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s004",
          "field": "step",
          "locale": "en",
          "position": 3,
          "text": "Brown the minced meat with onion and a little tomato, season it and let the liquid cook away.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s005",
          "field": "step",
          "locale": "en",
          "position": 4,
          "text": "Make the béchamel by whisking butter and flour into milk, and cook it until it thickens enough to coat a spoon.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s006",
          "field": "step",
          "locale": "en",
          "position": 5,
          "text": "Assemble in layers — aubergine, meat, aubergine, meat — and finish with the béchamel.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s007",
          "field": "step",
          "locale": "en",
          "position": 6,
          "text": "Bake at 180°C until the top is browned and the middle is hot through, about an hour.",
          "isOriginal": true
        },
        {
          "id": "00000000-0000-0000-0000-00000000s008",
          "field": "note",
          "locale": "en",
          "position": 1,
          "text": "Let it stand for a quarter of hour before cutting: the béchamel sets as it cools, and the layers hold together.",
          "isOriginal": true
        }
      ],
