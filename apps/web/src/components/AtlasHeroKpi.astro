---
// Static-rendered hero KPI band for the homepage.
//
// Why this exists (P0-1):
//   The homepage (`/`) was 100% rendered via <GustaleHomeIsland client:only="react" />,
//   which during SSG emits an empty <astro-island> shell — meaning a visitor's first
//   paint of gustale.com/ shows no counts at all (the homepage HTML has no "60 dishes"
//   string anywhere). Competitor sites always lead with their numbers; Gustale's
//   "atlas of how food moved" claim sounds empty without them.
//
//   This component renders a tight hero band with the real catalog counts pulled from
//   /api/atlas/counts at build time (the same fetch the map page uses; cached by CI's mock
//   API during build — see apps/web/scripts/mock-api.mjs). When the React island
//   hydrates below it, the page gets its full interactive hero. The two coexist: this
//   band sits ABOVE the workspace and visually anchors the top of the fold; the
//   React hero (which already shows the same numbers in its own `.hero-meta`) sits
//   BELOW it.
//
// P4 — THE COUNTS ARE NOW DEFINED (ADR-004 F7)
//
//   The first version computed its four numbers from the LIST endpoint's
//   legacy fields, and that was wrong in three ways at once:
//
//     - "families" counted the LEGACY `dish-type` categories, not the
//       family dimension the brief's D2 makes the source of truth;
//     - "lineages" counted a TECHNIQUE (the `method` field);
//     - "origins" counted distinct origin NAMES, of which 42 on live
//       are regions and cultural areas rather than countries — so
//       calling them "origins" beside a nav item labelled
//       "Countries" was a mismatch the reader could see.
//
//   The counts now come from /api/atlas/counts, which counts DISTINCT
//   dishes and DISTINCT entities and returns a DEFINITION for each
//   number. The definitions are rendered on the page, because a count
//   nobody can interpret is the defect the ADR recorded.
//
//   The labels follow the definitions rather than a fixed list, so a
//   number and its meaning cannot drift apart.

import { ApiError, getAtlasCounts } from "../lib/api";

interface Counts {
  dishes: number;
  places: number;
  communities: number;
  families: number;
  techniques: number;
  connections: number;
  ok: true;
  // useful when the SSG fetch fails: render placeholders rather than zero.
  ok_false_reason?: string;
  // The definitions, so the page can say what each number means.
  definitions?: Record<string, string>;
}

// The four statistics the homepage shows, and the order they appear in.
//
// The keys are the COUNT endpoint's keys, so the number and its label
// come from the same place.
const STATS = [
  { key: "dishes", label: "dishes" },
  { key: "places", label: "places" },
  { key: "families", label: "food families" },
  { key: "connections", label: "connections" },
] as const;

async function fetchCounts(): Promise<Counts> {
  try {
    const resp = await getAtlasCounts();
    return {
      dishes: resp.counts.dishes,
      places: resp.counts.places,
      communities: resp.counts.communities,
      families: resp.counts.families,
      techniques: resp.counts.techniques,
      connections: resp.counts.connections,
      definitions: resp.definitions,
      ok: true,
    };
  } catch (err) {
    // Do NOT show zeros. Render placeholders + a tiny note instead so a build-
    // time API outage doesn't produce a deceptive "0 dishes" homepage.
    const reason =
      err instanceof ApiError
        ? `API ${err.status}`
        : err instanceof Error
          ? err.message
          : "unknown";
    return {
      dishes: 0,
      places: 0,
      communities: 0,
      families: 0,
      techniques: 0,
      connections: 0,
      ok: false,
      ok_false_reason: reason,
    };
  }
}

const counts = await fetchCounts();

// PR 3 — A COUNTER IS NEVER A DASH, AND A ZERO IS NOT A KPI.
//
// The old formatter returned "—" for any zero, which put a dash on
// the page exactly where a reader expects a number. A dash reads as
// "this is a metric and its value is not available", and on a page
// whose whole claim is that it has numbers, that is worse than not
// showing the metric at all.
//
// The rules now, in full:
//
//   * a metric with NO DATA is not rendered at all;
//   * a metric whose value is a real ZERO is not rendered either --
//     because "0 places" in a KPI band is a claim, and a claim of
//     zero next to three real numbers reads as a defect. A "0"
//     belongs in an EMPTY STATE that has an action attached ("0
//     places yet — add one"), and this band is not that;
//   * a metric with a real number is rendered as that number.
//
// The degraded build is the same rule: there the numbers are unknown,
// not zero, so nothing is claimed and the band says so in words.
const fmt = (n: number): string => new Intl.NumberFormat("en-US").format(n);

// Which stats have a value worth showing.
//
// The distinction between "no data" and "zero" matters here: the
// counts endpoint returns a NUMBER for every key, so a zero here is
// a real zero (the catalogue genuinely has no such entities), while
// a missing key means the API did not answer. The degraded branch
// covers the second case.
const visibleStats = STATS.filter((stat) => {
  const n = counts[stat.key];
  if (typeof n !== "number") return false;
  // A real zero is not a KPI. Neither is an unknown value on a
  // degraded build.
  if (n === 0) return false;
  return true;
});
---

<section
  class:list={[
    'atlas-kpi',
    !counts.ok && 'atlas-kpi--degraded',
  ]}
  aria-label="Atlas at a glance"
>
  <div class="wrap">
    <p class="atlas-kpi__kicker">
      Browse the Gustale atlas
    </p>
    <h2 class="atlas-kpi__title">
      The open atlas of how food moved.
    </h2>

    <div class="atlas-kpi__stats" role="list">
      {visibleStats.map((stat) => (
        <div role="listitem" title={counts.definitions?.[stat.key] ?? ""}>
          <b>{fmt(counts[stat.key])}</b>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>

    {
      counts.ok && counts.definitions && (
        <dl class="atlas-kpi__definitions">
          {STATS.map((stat) => (
            <div>
              <dt>{stat.label}</dt>
              <dd>{counts.definitions?.[stat.key]}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      !counts.ok && (
        <p class="atlas-kpi__note">
          Live counts unavailable during build ({counts.ok_false_reason ?? 'unknown'}).
          Showing placeholders. The interactive page below uses the live API.
        </p>
      )
    }
  </div>
</section>

<style>
  .atlas-kpi {
    /* Keep contrast with the React island hero below — a tight top band,
       not a full competing hero. ~150px tall, leaves the rest of the
       viewport for the interactive workspace. */
    padding: 38px 0 28px;
    border-bottom: 1px solid var(--line, rgba(33, 28, 22, 0.14));
    background: var(--card, #fbf8f1);
  }
  .atlas-kpi .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .atlas-kpi__kicker {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sub, #6b6052);
    margin: 0 0 8px;
  }
  .atlas-kpi__title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.1;
    margin: 0 0 22px;
    color: var(--ink, #211c16);
  }
  .atlas-kpi__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: baseline;
  }
  .atlas-kpi__stats > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
    color: var(--sub, #6b6052);
    font-size: 14px;
  }
  .atlas-kpi__stats b {
    font-family: 'Instrument Serif', Georgia, serif;
    font-weight: 400;
    font-size: 26px;
    color: var(--ink, #211c16);
  }
  .atlas-kpi--degraded .atlas-kpi__stats b { color: var(--sub, #6b6052); }
  /* The definitions. A count nobody can interpret is the defect the ADR
     recorded, so the page says what each number means. */
  .atlas-kpi__definitions {
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 10px 26px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--sub, #6b6052);
  }
  .atlas-kpi__definitions > div { display: flex; gap: 7px; }
  .atlas-kpi__definitions dt {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--sub, #6b6052);
  }
  .atlas-kpi__definitions dd { margin: 0; }
  .atlas-kpi__note {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--sub, #6b6052);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
  }
  @media (max-width: 640px) {
    .atlas-kpi__stats { gap: 20px; }
    .atlas-kpi__stats b { font-size: 22px; }
  }
</style>
