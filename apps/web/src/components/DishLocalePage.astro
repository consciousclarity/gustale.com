---
import Layout from "../layouts/Layout.astro";
import {
  getDishDetail,
  getDishJourney,
  getDishRelations,
  type RelatedDish,
} from "../lib/api";
import { buildLocales } from "../lib/buildScope";
import { getFilterPageIndex, pathPageSlugs } from "../lib/filterPages";
import { type CoreLocale, dishUrl, hreflangAlternates } from "../lib/locales";
import type { DishDetailResponse } from "../types/dish";
import { DishContentSections } from "./DishContentSections";
import { DishDetail } from "./DishDetail";
import type { JourneyBeat } from "./DishJourney";
import { EditDishButton } from "./EditDishButton";
import { RelatedDishes } from "./RelatedDishes";

export interface Props {
  slug: string;
  locale: CoreLocale;
  /** The origin the site is served from, for the hreflang URLs. */
  origin: string;
}

const { slug, locale, origin } = Astro.props;

// Category / method / region links go to the static path pages.
let pathPages = null;
try {
  pathPages = pathPageSlugs(await getFilterPageIndex());
} catch {
  // Query-form fallback.
}

// ── The dish, in this locale ──────────────────────────────────────────
let data: DishDetailResponse | null = null;
let notFound = false;

try {
  data = await getDishDetail(slug, { language: locale });
} catch (err) {
  console.error(`[dish/${locale}] fetch failed:`, err);
  notFound = true;
}

if (!data && !notFound) notFound = true;
if (notFound) {
  Astro.response.status = 404;
}

// ── The journey beats ──────────────────────────────────────────────────
let journeyBeats: JourneyBeat[] = [];
let journeyStatus: "history" | "gap" | "unavailable" = "gap";
try {
  const j = await getDishJourney(slug);
  journeyBeats = (j as any)?.beats ?? [];
  // A dish with no chapters is a research gap; a failed fetch is an
  // operational failure. The page must not confuse the two.
  journeyStatus = (j as any)?.status === "history" ? "history" : "gap";
} catch {
  // The journey is optional — a dish without one still renders. But a
  // failed fetch is NOT a research gap.
  journeyStatus = "unavailable";
}

// ── The relations, for the Connections block ───────────────────────────
//
// `null` means "not fetched", which is DIFFERENT from `[]` — an empty
// array claims the dish has no relations, and that is a claim.
let relations: RelatedDish[] | null = null;
try {
  const r = await getDishRelations(slug);
  relations = r.related ?? null;
} catch {
  relations = null;
}

// ── The locales this dish actually has content in ─────────────────────
//
// The hreflang set is the locales the site ships pages for, not the
// locales the dish happens to have a name in. A dish with a Tagalog
// name but no Tagalog page would advertise a URL that 404s.
const BUILD_LOCALES = buildLocales();
const alternates = hreflangAlternates(slug, BUILD_LOCALES, origin);

// ── The English-fallback notice ────────────────────────────────────────
//
// The API reports the locale it served alongside the one that was
// asked for. When they differ, this page has no translation and is
// showing English — and the ADR says to SAY SO, not to swap silently.
const servedEnglish =
  data !== null && data.requestedLocale !== data.locale && data.locale === "en";

// ── SEO ────────────────────────────────────────────────────────────────
const seoTitle = data?.dish
  ? `${data.dish.name} — Gustale`
  : "Dish not found — Gustale";
const seoDescription =
  data?.dish?.description ??
  data?.dish?.shortDescription ??
  "A digital culinary archive.";

// The language switcher: the same dish in every locale the site ships.
const localeUrls = Object.fromEntries(
  BUILD_LOCALES.map((l) => [l, `${origin}${dishUrl(l, slug)}`]),
);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  locale={locale}
  alternates={alternates}
  localeUrls={localeUrls}
  canonicalUrl={localeUrls[locale]}
>
  {data ? (
    <>
      {servedEnglish && (
        <div class="gst-locale-notice" role="status">
          <span class="gst-locale-notice__text">
            This page is not yet available in your language, so it is
            shown in English.
          </span>
          <a class="gst-locale-notice__link" href={localeUrls[locale]}>
            View other languages
          </a>
        </div>
      )}

      <DishDetail
        dish={data.dish}
        origin={data.origin}
        categories={data.categories}
        tags={data.tags}
        media={data.media}
        unevidenced={data.unevidenced}
        dimensions={data.dimensions}
        names={data.names}
        places={[]}
        hasWhere={data.origin !== null}
        hasHistory={true}
        hasConnections={true}
        hasVariants={true}
        hasIngredients={data.ingredients.length > 0}
        hasRecipes={true}
        hasSources={true}
        pathPages={pathPages}
        client:load
      />

      {/* THE CONTENT SECTIONS (WP-C2) — the same sections the default
      locale's dish page renders, in the same order, so a localised page
      is not a different page. */}
      <div class="wrap">
        <DishContentSections
          dish={data.dish}
          relations={relations}
          variants={data.variants}
          ingredients={data.ingredients}
          preparations={data.preparations}
          sources={data.sources}
          recipes={[]}
          journeyBeats={journeyBeats}
          journeyStatus={journeyStatus}
          unevidenced={data.unevidenced}
        />
      </div>

      <RelatedDishes slug={data.dish.slug} client:visible />

      <div class="gst-dish-actions">
        <EditDishButton slug={data.dish.slug} client:load />
      </div>
    </>
  ) : (
    <>
      <h1 class="page-header">Dish not found</h1>
      <p class="gst-muted">
        We couldn't find a dish called <strong>{slug}</strong>.
      </p>
    </>
  )}
</Layout>
