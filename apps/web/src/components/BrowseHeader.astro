---
/**
 * Shared browse header for list pages.
 *
 * Editorial hero + sticky toolbar (68px below site header).
 * Search input and optional filters panel come from slots so each
 * page/island can own interactive controls without duplicate IDs.
 *
 * Slots:
 *   - search-input  (required for interactive pages) — the <input>
 *   - after-search  — chips / clear / status
 *   - filters       — disclosure panel body
 */

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  /** Initial SSR count label (island may update via data-browse-count). */
  countLabel: string;
  searchId?: string;
  filtersId?: string | null;
  activeFilterCount?: number;
  filtersLabel?: string;
  /** Hide Filters button when the page has no advanced filters. */
  showFilters?: boolean;
  /** When false, only the editorial hero is rendered (island owns toolbar). */
  showToolbar?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  countLabel,
  searchId = 'browse-search',
  filtersId = 'browse-filters',
  activeFilterCount = 0,
  filtersLabel = 'Filters',
  showFilters = Boolean(filtersId),
  showToolbar = true,
} = Astro.props;

const hasFilters = showFilters && Boolean(filtersId);
---

<header class="browse-hero wrap">
  <p class="browse-eyebrow">{eyebrow}</p>
  <h1 class="browse-h1">{title}</h1>
  <p class="browse-sub">{subtitle}</p>
</header>

{showToolbar && (
<div class="browse-toolbar" data-browse-toolbar>
  <div class="wrap">
    <div class="browse-toolbar-row">
      <div class="browse-search">
        <span class="browse-search-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
            <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
        </span>
        <slot name="search-input">
          <input
            id={searchId}
            type="search"
            class="browse-search-field"
            placeholder="Search…"
            autocomplete="off"
            spellcheck="false"
          />
        </slot>
      </div>

      <p
        class="browse-count"
        aria-live="polite"
        aria-atomic="true"
        data-browse-count
      >
        {countLabel}
      </p>

      {hasFilters && (
        <button
          type="button"
          class="browse-filters-btn"
          id={`${filtersId}-trigger`}
          aria-controls={filtersId!}
          aria-expanded="false"
          data-browse-filters-trigger
        >
          <span class="browse-filters-btn-label">{filtersLabel}</span>
          <span class="browse-filters-btn-icon" aria-hidden="true">▾</span>
          {activeFilterCount > 0 && (
            <span class="browse-filters-btn-badge" data-browse-filters-badge>
              {activeFilterCount}
            </span>
          )}
        </button>
      )}
    </div>

    <div class="browse-toolbar-extra" data-browse-extra>
      <slot name="after-search" />
    </div>

    {hasFilters && (
      <div
        class="browse-filters-panel"
        id={filtersId!}
        hidden
        data-browse-filters-panel
        role="region"
        aria-label={filtersLabel}
      >
        <slot name="filters" />
      </div>
    )}
  </div>
</div>
)}

{showToolbar && (
<script>
  const toolbar = document.querySelector<HTMLElement>('[data-browse-toolbar]');
  if (toolbar) {
    const trigger = toolbar.querySelector<HTMLButtonElement>('[data-browse-filters-trigger]');
    const panel = toolbar.querySelector<HTMLElement>('[data-browse-filters-panel]');
    let lastFocus: HTMLElement | null = null;

    function setOpen(open: boolean) {
      if (!trigger || !panel) return;
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
      if (open) {
        lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
        const first = panel.querySelector<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
        );
        first?.focus();
      } else {
        (lastFocus ?? trigger).focus();
        lastFocus = null;
      }
    }

    trigger?.addEventListener('click', () => {
      const open = trigger.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!panel || panel.hidden) return;
      e.preventDefault();
      setOpen(false);
    });

    document.addEventListener('click', (e) => {
      if (!panel || panel.hidden || !trigger) return;
      const t = e.target;
      if (!(t instanceof Node)) return;
      if (panel.contains(t) || trigger.contains(t)) return;
      setOpen(false);
    });
  }
</script>
)}

<style>
  .browse-hero {
    padding: 36px 0 20px;
  }
  .browse-eyebrow {
    margin: 0 0 10px;
    color: var(--sub);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
  .browse-h1 {
    margin: 0 0 12px;
    font-family: var(--display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .browse-sub {
    margin: 0;
    max-width: 56ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--sub);
  }

  .browse-toolbar {
    position: sticky;
    top: 68px;
    z-index: 30;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .browse-toolbar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    min-height: 56px;
  }
  .browse-search {
    flex: 1 1 auto;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: var(--sub);
    transition: border-color 0.15s;
  }
  .browse-search:focus-within {
    border-color: var(--accent);
  }
  .browse-search-icon {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--sub);
  }
  .browse-search :global(.browse-search-field),
  .browse-search-field {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    outline: none;
    width: 100%;
  }
  .browse-count {
    flex: 0 0 auto;
    margin: 0;
    color: var(--sub);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .browse-filters-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 44px;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    color: inherit;
    font: inherit;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .browse-filters-btn:hover {
    border-color: var(--accent);
  }
  .browse-filters-btn[aria-expanded='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }
  .browse-filters-btn:focus-visible,
  .browse-search-field:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .browse-filters-btn-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }
  .browse-toolbar-extra:empty {
    display: none;
  }
  .browse-toolbar-extra {
    padding: 0 0 12px;
  }
  .browse-filters-panel {
    padding: 0 0 16px;
    border-top: 1px dashed var(--line);
  }
  .browse-filters-panel[hidden] {
    display: none !important;
  }

  @media (max-width: 640px) {
    .browse-toolbar-row {
      gap: 8px;
    }
    .browse-count {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .browse-filters-btn-label {
      display: none;
    }
    .browse-filters-btn {
      padding: 0 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .browse-toolbar {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .browse-search,
    .browse-filters-btn {
      transition: none;
    }
  }
</style>
