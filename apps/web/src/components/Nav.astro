---
/**
 * Canonical public header — mounted by Layout.astro.
 * SiteHeader.astro is a stale unused alternative and must not be reintroduced.
 */
import '../styles/global.css';
import { AuthMenu } from './AuthMenu';
import { GlobalSearch } from './GlobalSearch';
import {
  ATLAS_ORIGIN,
  RECIPES_ORIGIN,
  authoringHref,
  currentDomain,
  isGeoDomain,
} from '../lib/domain';

const domain = currentDomain();
const isGeo = isGeoDomain();

const atlasProperty = {
  id: 'atlas' as const,
  label: 'Atlas',
  description: 'Explore the world through food.',
  href: `${ATLAS_ORIGIN}/`,
};
const recipesProperty = {
  id: 'recipes' as const,
  label: 'Recipes',
  description: 'Cook and contribute recipes.',
  href: `${RECIPES_ORIGIN}/`,
};

const currentProperty = isGeo ? atlasProperty : recipesProperty;

/** Primary nav — only routes that exist in the corresponding post-build dist. */
const primaryLinks = isGeo
  ? [
      { href: '/', label: 'Globe', match: (p: string) => p === '/' },
      { href: '/regions', label: 'Countries', match: (p: string) => p.startsWith('/regions') },
      { href: '/families', label: 'Food families', match: (p: string) => p.startsWith('/families') || p.startsWith('/family') },
      { href: '/lineages', label: 'Lineages', match: (p: string) => p.startsWith('/lineages') },
      { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
    ]
  : [
      { href: '/dishes', label: 'Recipes', match: (p: string) => p === '/dishes' || p.startsWith('/dishes/') },
      { href: '/ingredients', label: 'Ingredients', match: (p: string) => p.startsWith('/ingredients') },
      { href: '/families', label: 'Food families', match: (p: string) => p.startsWith('/families') || p.startsWith('/family') },
      { href: '/lineages', label: 'Lineages', match: (p: string) => p.startsWith('/lineages') },
      { href: '/about', label: 'About', match: (p: string) => p.startsWith('/about') },
    ];

const contributeHref = '/contribute';
const addDishHref = authoringHref('/dishes/new');
---

<header class="gst-header" data-domain={domain}>
  <nav class="gst-nav" id="main-nav" aria-label="Primary" data-domain={domain}>
    <div class="wrap gst-nav-in">

      <!-- Brand: Gustale + current property (text, not color-only) -->
      <a href="/" class="gst-brand">
        <span class="gst-wordmark">Gustale</span>
        <span class="gst-property" aria-label={`Current property: ${currentProperty.label}`}>
          <span class="gst-property-label">{currentProperty.label}</span>
          <span class="gst-property-desc gst-property-desc--desktop">{currentProperty.description}</span>
        </span>
      </a>

      <!-- Explicit Atlas / Recipes switcher (absolute URLs) -->
      <div
        class="property-switch"
        role="group"
        aria-label="Gustale property"
      >
        <a
          href={atlasProperty.href}
          class="property-switch__opt"
          data-active={isGeo ? 'true' : undefined}
          aria-current={isGeo ? 'page' : undefined}
          title={atlasProperty.description}
        >
          <span class="property-switch__name">Atlas</span>
          <span class="property-switch__hint">gustale.com</span>
        </a>
        <a
          href={recipesProperty.href}
          class="property-switch__opt"
          data-active={!isGeo ? 'true' : undefined}
          aria-current={!isGeo ? 'page' : undefined}
          title={recipesProperty.description}
        >
          <span class="property-switch__name">Recipes</span>
          <span class="property-switch__hint">gustale.recipes</span>
        </a>
      </div>

      <GlobalSearch client:load variant="compact" placement="header" />

      <div class="gst-navlinks" id="nav-links">
        {primaryLinks.map((link) => (
          <a
            href={link.href}
            class="gst-navlink"
            data-nav-href={link.href}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="gst-navr" id="nav-right">
        <AuthMenu client:load />
        <a href={contributeHref} class="btn-accent gst-nav-contribute">Contribute</a>
        <a href={addDishHref} class="gst-ghost gst-nav-add-dish">Add a dish</a>

        <button
          class="nav-mobile-toggle"
          id="nav-mobile-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-mobile-drawer"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="nav-mobile-drawer" id="nav-mobile-drawer" hidden>
      <div class="nav-mobile-inner wrap">
        <p class="nav-mobile-property" aria-live="polite">
          <strong>Gustale {currentProperty.label}</strong>
          <span>{currentProperty.description}</span>
        </p>

        <GlobalSearch client:load variant="full" placement="drawer" />

        <div class="nav-mobile-divider" role="presentation" />

        <p class="nav-mobile-section" id="nav-mobile-primary-label">Browse</p>
        <div role="group" aria-labelledby="nav-mobile-primary-label">
          {primaryLinks.map((link) => (
            <a href={link.href} class="nav-mobile-link" data-nav-href={link.href}>{link.label}</a>
          ))}
        </div>

        <div class="nav-mobile-divider" role="presentation" />

        <p class="nav-mobile-section" id="nav-mobile-switch-label">Switch property</p>
        <div class="property-switch property-switch--mobile" role="group" aria-labelledby="nav-mobile-switch-label">
          <a
            href={atlasProperty.href}
            class="property-switch__opt"
            data-active={isGeo ? 'true' : undefined}
            aria-current={isGeo ? 'page' : undefined}
          >
            <span class="property-switch__name">Atlas</span>
            <span class="property-switch__hint">{atlasProperty.description}</span>
          </a>
          <a
            href={recipesProperty.href}
            class="property-switch__opt"
            data-active={!isGeo ? 'true' : undefined}
            aria-current={!isGeo ? 'page' : undefined}
          >
            <span class="property-switch__name">Recipes</span>
            <span class="property-switch__hint">{recipesProperty.description}</span>
          </a>
        </div>

        <div class="nav-mobile-divider" role="presentation" />

        <a href="/login" class="nav-mobile-link">Sign in</a>
        <a href={contributeHref} class="nav-mobile-link">Contribute</a>
        <a href={addDishHref} class="nav-mobile-link nav-mobile-link--accent">Add a dish</a>
      </div>
    </div>
  </nav>
</header>

<script>
const nav = document.getElementById('main-nav');
const pathname = window.location.pathname;

document.querySelectorAll<HTMLElement>('[data-nav-href]').forEach((link) => {
  const href = link.getAttribute('data-nav-href') ?? '';
  let on = false;
  if (href === '/') {
    on = pathname === '/';
  } else if (href === '/dishes') {
    on = pathname === '/dishes' || pathname === '/dishes/' || pathname.startsWith('/dishes/');
  } else {
    on = pathname === href || pathname.startsWith(`${href}/`) || pathname.startsWith(href);
  }
  // Food families: also highlight for /family/:slug
  if (href === '/families' && pathname.startsWith('/family')) on = true;
  if (on) link.dataset.on = '1';
});

const toggle = document.getElementById('nav-mobile-toggle');
const drawer = document.getElementById('nav-mobile-drawer');
if (toggle && drawer) {
  toggle.addEventListener('click', () => {
    const open = drawer.hidden !== true;
    drawer.hidden = open;
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.hidden === false) {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!nav?.contains(e.target as Node) && drawer.hidden === false) {
      drawer.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
    }
  });
}
</script>

<style>
.gst-header {
  position: sticky;
  top: 0;
  z-index: 40;
}

.gst-property {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}
.gst-property-label {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: var(--accent);
  line-height: 1.1;
}
.gst-property-desc {
  font-size: 11px;
  color: var(--sub);
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 14rem;
}
.gst-property-desc--desktop {
  display: none;
}
@media (min-width: 1100px) {
  .gst-property-desc--desktop {
    display: block;
  }
}

.property-switch {
  display: inline-flex;
  align-items: stretch;
  border: 1px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--card, #fbf8f1);
}
.property-switch__opt {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1px;
  padding: 5px 10px;
  text-decoration: none;
  color: var(--sub);
  min-width: 4.5rem;
  border-right: 1px solid var(--line);
  transition: background 0.14s, color 0.14s;
}
.property-switch__opt:last-child {
  border-right: none;
}
.property-switch__opt:hover {
  color: var(--ink);
  background: var(--accent-soft);
}
.property-switch__opt[data-active='true'],
.property-switch__opt[aria-current='page'] {
  color: var(--ink);
  background: #fff;
  box-shadow: inset 0 0 0 1px var(--accent);
}
.property-switch__name {
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.9px;
  text-transform: uppercase;
  font-weight: 600;
}
.property-switch__hint {
  font-size: 10px;
  opacity: 0.75;
  line-height: 1.2;
}
.property-switch--mobile {
  width: calc(100% - 36px);
  margin: 0 18px;
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.property-switch--mobile .property-switch__opt {
  min-width: 0;
  padding: 10px 12px;
}
.property-switch--mobile .property-switch__hint {
  font-size: 11px;
  white-space: normal;
}

.gst-navlinks {
  display: flex;
  align-items: center;
  gap: 2px;
}
.gst-navlink {
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  opacity: 0.72;
  padding: 6px 10px;
  border-radius: var(--radius);
  transition: opacity 0.14s, color 0.14s, background 0.14s;
  white-space: nowrap;
}
.gst-navlink:hover,
.gst-navlink[data-on='1'] {
  opacity: 1;
  color: var(--accent);
}
.gst-navlink:focus-visible,
.property-switch__opt:focus-visible,
.nav-mobile-link:focus-visible,
.nav-mobile-toggle:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.gst-ghost {
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  opacity: 0.72;
  transition: opacity 0.14s, color 0.14s;
}
.gst-ghost:hover {
  opacity: 1;
  color: var(--accent);
}

.nav-mobile-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--ink);
  padding: 4px;
  border-radius: var(--radius);
}

.nav-mobile-drawer {
  border-top: 1px solid var(--line);
  background: var(--bg);
  max-height: min(80vh, 640px);
  overflow-y: auto;
}
.nav-mobile-inner {
  display: flex;
  flex-direction: column;
  padding: 12px 0 20px;
  gap: 2px;
}
.nav-mobile-property {
  margin: 4px 18px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.nav-mobile-property strong {
  font-family: var(--display);
  font-size: 1.25rem;
}
.nav-mobile-property span {
  color: var(--sub);
  font-size: 0.9rem;
  line-height: 1.4;
}
.nav-mobile-section {
  margin: 4px 18px 2px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.9px;
  text-transform: uppercase;
  color: var(--sub);
}
.nav-mobile-link {
  display: block;
  padding: 12px 18px;
  font-size: 16px;
  color: var(--ink);
  text-decoration: none;
  border-radius: var(--radius);
  transition: background 0.12s, color 0.12s;
  min-height: 44px;
  box-sizing: border-box;
}
.nav-mobile-link:hover,
.nav-mobile-link[data-on='1'] {
  background: var(--accent-soft);
  color: var(--accent);
}
.nav-mobile-link--accent {
  background: var(--accent);
  color: var(--accent-ink) !important;
  border-radius: 999px;
  margin: 8px 18px 0;
  text-align: center;
  font-weight: 500;
}
.nav-mobile-link--accent:hover {
  filter: brightness(0.95);
}
.nav-mobile-divider {
  height: 1px;
  background: var(--line);
  margin: 10px 18px;
}

@media (max-width: 960px) {
  .gst-navlinks {
    display: none;
  }
  .gst-navr > .gst-ghost,
  .gst-navr > .btn-accent,
  .gst-nav-add-dish,
  .gst-nav-contribute {
    display: none;
  }
  .nav-mobile-toggle {
    display: flex;
  }
  .property-switch:not(.property-switch--mobile) {
    display: none;
  }
}

@media (max-width: 640px) {
  .gst-property-desc {
    display: none;
  }
}
</style>
