---
import "../styles/global.css";
// The recipes theme (the approved herb-green accent).
//
// It is imported UNCONDITIONALLY, and that is safe: every rule in it
// is scoped to `body[data-domain="recipes"]`, and the attribute is set
// by this component. The Atlas build ships the same few bytes of CSS
// and matches none of them, so the Atlas keeps its terracotta.
//
// It cannot be a conditional import: Astro hoists imports, so
// `if (isGeo) await import(...)` is not a thing in a frontmatter. The
// attribute is what makes the scoping work, not the import.
import "../styles/recipes-theme.css";
import { LocaleSuggestion } from "../components/LocaleSuggestion";
import LocaleSwitcher from "../components/LocaleSwitcher.astro";
import Nav from "../components/Nav.astro";
import { isGeoDomain } from "../lib/domain";
import {
  type CoreLocale,
  isRtl,
  localeUrlsForPath,
  siteOrigin as resolveSiteOrigin,
} from "../lib/locales";
import { siteSections } from "../lib/sections";

export interface Props {
  title: string;
  description?: string;
  /**
   * The ACCENT THEME for this page.
   *
   * "atlas" (the default) is the terracotta the Atlas has always used.
   * "recipes" is the herb green, and it belongs to the RECIPE pages
   * only.
   *
   * WHY THIS IS A PER-PAGE FLAG AND NOT A PER-SITE ONE
   *
   * The site is one build now: there is no separate recipes property
   * and no separate geo property. `data-domain="recipes"` used to mean
   * "this is the recipes site", and it was set on every page, which
   * tinted the whole site herb green -- including the dish pages, where
   * the "Add a dish" button is terracotta on every other page and was
   * green here.
   *
   * The design decision is that the herb green is the RECIPES theme:
   * it marks the recipe pages and nothing else. So the attribute now
   * says what the page IS, and the pages that are not recipes keep the
   * terracotta.
   */
  theme?: "atlas" | "recipes";
  /**
   * The locale of this page. It sets `lang` and `dir` on the <html>
   * element, and picks the right Noto font stack.
   */
  locale?: CoreLocale;
  /**
   * The `hreflang` alternates for this page. Reciprocal, plus
   * `x-default` pointing at the English URL.
   */
  alternates?: Array<{ hreflang: string; href: string }>;
  /**
   * The URL of this page in each locale, for the language switcher.
   */
  localeUrls?: Record<string, string>;
  /**
   * The canonical URL of this page — the absolute URL of THIS page,
   * in THIS locale.
   *
   * WHY IT IS SELF-REFERENTIAL AND NOT THE ENGLISH ONE
   *
   * A canonical tag says "this is the authoritative copy of this
   * content". On a site with ten locales of the same dish, the
   * English URL is NOT the authoritative copy of the Spanish page —
   * they are different pages, in different languages, and a search
   * engine should show the Spanish one to a Spanish reader.
   *
   * Pointing every locale's canonical at the English URL would tell
   * the engine that the nine translations are duplicates of the
   * English one, and it would then fold them out of the index. The
   * hreflang alternates would then be pointing at pages the engine
   * has been told not to index, which defeats the whole multilingual
   * structure.
   *
   * So: each page's canonical is itself. The alternates say "there
   * are these other versions"; the canonical says "this one is me".
   *
   * It is omitted entirely when the page has no absolute URL, rather
   * than emitted with an empty href — an empty canonical is worse
   * than none, because it is an instruction, not a description.
   */
  canonicalUrl?: string;
  /**
   * Mark the page `noindex, follow`.
   *
   * Used for the pages that exist but carry no content yet — a family
   * page whose dishes have not been mapped, a lineage with nothing
   * mapped to it. They stay reachable and keep their invitation to
   * contribute, but they are kept out of the index and out of the
   * sitemap.
   */
  noindex?: boolean;
}

const {
  title,
  description = "Gustale — a digital culinary archive.",
  locale = "en",
  alternates = [],
  localeUrls = {},
  canonicalUrl: canonicalProp,
  noindex = false,
  theme = "atlas",
} = Astro.props;

// THE FOOTER'S LANGUAGE SWITCHER
// ------------------------------
// A page that knows its own locale variants passes `localeUrls`. Only
// the dish pages did, so the footer had NO switcher on the home page,
// the families, the lineages or any other page -- and the brief asks
// for the switcher on every page.
//
// When the page does not supply them, the variants are derived from
// the path. `localeUrlsForPath` returns a variant only where one
// actually exists: the site builds one locale-prefixed route,
// `/[locale]/dishes/[slug]`, so a dish page has a variant in every
// locale and nothing else does.
//
// A page with no locale variant still shows the switcher, with the
// current language alone. That is honest: it says which language the
// page is in, and it offers no link that would 404. D21-9 widens the
// set once locale pages are published and indexed.
const pathLocaleUrls = localeUrlsForPath(Astro.url.pathname);
const footerLocaleUrls =
  Object.keys(localeUrls).length > 0 ? localeUrls : pathLocaleUrls;
const isGeo = isGeoDomain();

// The six sections, for the footer. The header reads the same list --
// see `lib/sections.ts` for why there is only one of it.
const sections = siteSections();
const rtl = isRtl(locale);

// The canonical, when the page does not name one.
//
// It DEFAULTS to this page's own absolute URL — self-referential —
// rather than being left off.
//
// WHY NOT LEAVE IT OFF
//
// The site has ten locales of every dish. Without a canonical, the
// nine translations of a dish are nine candidate URLs for the same
// content, and a search engine has to guess which one the query
// meant. With a self-referential canonical, each locale says "this
// one is me" and the hreflang alternates say "these are the other
// versions" — which is the pair a search engine needs to serve the
// Spanish page to a Spanish reader.
//
// WHY NOT THE ENGLISH URL
//
// The English URL is not the authoritative copy of the Spanish page.
// They are different pages in different languages. Pointing every
// locale at the English one tells the engine the translations are
// duplicates, and it folds them out of the index.
//
// The 404 page is the exception: it has no canonical, because it is
// not a page that should be in an index at all. A 404 that declares
// itself canonical asks to be indexed.
// The shared origin resolver, so a staging build gets its own origin
// and its own canonical URLs. This used to inline its own copy of the
// logic, which is how the staging origin got missed on the dish pages.
const siteOrigin = resolveSiteOrigin();

// The 404 page. It is detected from the PAGE, not the URL: Astro
// serves it for any missing path, so the pathname at build time is
// "/404" but at request time it is whatever the reader asked for.
// The build-time check is what matters here — the 404 page is built
// once, and its canonical is decided then.
const isNotFound =
  Astro.props.isNotFound === true ||
  Astro.url.pathname === "/404" ||
  Astro.url.pathname === "/404/";
const canonicalUrl =
  canonicalProp ??
  (isNotFound
    ? undefined
    : `${siteOrigin}${Astro.url.pathname.replace(/\/+$/, "") || "/"}`);

// The `og:url` — the Open Graph URL of THIS page.
//
// It is the SAME variable as the canonical, on purpose. A canonical
// and an og:url that disagree is a site that tells a crawler two
// different things about where it is, and the crawler is entitled to
// believe either.
//
// It is NOT computed from `Astro.url` separately: at build time
// `Astro.url` has no origin, so a separate computation would yield a
// path-only value, which is not a URL.
//
// og:url is emitted only when there IS a canonical — that is, not on
// the 404 page. A 404 that advertises a URL to a social card is
// advertising a page that does not exist.
//
// WHY IT IS HERE AND NOT IN A PAGE
// --------------------------------
// The <head> is assembled in one place, and this is that place. A
// per-page og:url is how the two start to drift.
const ogUrl = canonicalUrl;

// The JSON-LD.
//
// THREE BLOCKS, TWO OF THEM HERE
// ------------------------------
// `WebSite` and `BreadcrumbList` are site-level and belong here: this
// is the only place that can see both the canonical URL and the
// locale. `Recipe` is per-dish and belongs on the dish page, where
// the dish's own data is -- a Recipe block in the layout would
// describe a recipe that is not the page.
//
// The JSON-LD uses the same `siteOrigin` as the canonical, so it
// cannot point at a different host than the page does.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Gustale",
    url: `${siteOrigin}/`,
    inLanguage: locale,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${siteOrigin}/`,
      },
      ...(Astro.url.pathname === "/" || Astro.url.pathname === "/"
        ? []
        : [
            {
              "@type": "ListItem",
              position: 2,
              name: title,
              item: canonicalUrl ?? `${siteOrigin}${Astro.url.pathname}`,
            },
          ]),
    ],
  },
];
---

<!doctype html>
<html lang={locale} dir={rtl ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <!--
      The OSM tile policy asks for a restrictive Referrer-Policy that
      prevents the Referer header being stripped, so that the tile
      requests carry a valid Referer. "strict-origin-when-cross-origin"
      sends the origin across origins — enough to identify the site,
      without leaking the full path.
    -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {
      alternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }
    {
      canonicalUrl && (
        <link rel="canonical" href={canonicalUrl} />
      )
    }
    {
      /*
       * THE OPEN GRAPH TAGS.
       *
       * They are NEW in the single-domain cutover. The site had a
       * canonical and hreflang and no Open Graph at all, which means a
       * shared link rendered as a bare URL with no title, no
       * description and no image.
       *
       * `og:url` reuses the canonical variable, so the two cannot
       * disagree -- see the note where it is defined.
       *
       * `og:image` points at the site's own image on the ONE origin. It
       * is absolute, because a social crawler fetches it out of
       * context and a relative path would resolve against nothing.
       *
       * IT IS THE SVG THAT EXISTS. There is no `og-image.png` in
       * `public/`, and pointing `og:image` at a file that is not
       * there is a promise the site cannot keep: the crawler fetches
       * it, gets a 404, and renders the card with no image. The hero
       * artwork is the site's own visual and it IS served.
       *
       * (A dedicated 1200x630 PNG would be better for a social card,
       * and several crawlers will not render an SVG at all. That is a
       * separate piece of work and it is NOT pretended to be done
       * here.)
       */
      ogUrl && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="Gustale" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={ogUrl} />
          <meta property="og:image" content={`${siteOrigin}/hero-world-land.svg`} />
          <meta property="og:locale" content={locale} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {
      /*
       * THE JSON-LD.
       *
       * `WebSite` and `BreadcrumbList`. The `Recipe` block is on the
       * dish page, where the recipe is.
       *
       * `set:html` with a JSON.stringify is the correct Astro idiom
       * here: the value is JSON, and escaping it as text would put
       * `&quot;` in the attribute.
       */
      !isNotFound && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    {
      /*
       * A page with no content behind it — a family page whose dishes
       * have not been mapped yet, a lineage with nothing mapped to it —
       * is a valid URL that a crawler can reach, but it is not worth
       * indexing. The empty pages stay reachable (they carry the
       * "help us map more dishes" invitation) and they are marked
       * noindex so they do not compete with the pages that do have
       * content.
       *
       * THE SITEMAP DOES NOT LIST THEM EITHER. The sitemap is generated
       * from the same data, so the two agree: a page is in the sitemap
       * if and only if it has content.
       */
      noindex && <meta name="robots" content="noindex, follow" />
    }
  </head>
  {/*
   * `data-domain` FOLLOWS THE PAGE'S THEME.
   *
   * It used to be `isGeo ? "geo" : "recipes"`, because the two builds
   * were two properties with two themes: the Atlas carried the
   * terracotta and the Recipes site the herb-green.
   *
   * There is one site now, so the property is no longer what decides
   * the accent. The PAGE does. The herb green is the recipes theme and
   * it is applied to the recipe pages; every other page -- the dish
   * pages, the Atlas, the families, the ingredient pages -- keeps the
   * terracotta it has always had.
   *
   * `recipes-theme.css` and `recipe-hub.css` are both scoped to
   * `body[data-domain="recipes"]`, so this attribute is what applies
   * them, and it is now set per page rather than site-wide.
   */}
  <body class="gst" data-domain={theme}>
    <Nav />

    {
      Object.keys(localeUrls).length > 0 && (
        <div class="wrap gst-locale-suggest-wrap">
          <LocaleSuggestion
            client:load
            current={locale}
            urls={localeUrls}
          />
        </div>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="gst-foot">
      <div class="wrap">
        <div>
          <div class="fm">Gustale</div>
          <div class="foot-locales">
            <LocaleSwitcher
              current={locale}
              urls={footerLocaleUrls}
            />
          </div>
          <div class="fcap">
            <a href="/" class="foot-domain" data-active={isGeo ? 'true' : undefined} aria-current={isGeo ? 'page' : undefined}>Atlas</a>
            <span class="foot-sep">·</span>
            <a href="/recipes" class="foot-domain" data-active={!isGeo ? 'true' : undefined} aria-current={!isGeo ? 'page' : undefined}>Recipes</a>
            <span class="foot-sep">·</span>
            Open knowledge, slow cooking — {new Date().getFullYear()}
          </div>
        </div>
        <div class="fl">
          {sections.map((section) => (
            <a
              href={section.path}
              class:list={{ "foot-link--external": section.external }}
              title={section.description}
            >
              {section.label}
            </a>
          ))}
          <a href="/contribute">Contribute</a>
          <a href="/about">About</a>
          <a href="/about/evidence">How we handle evidence</a>
          {/* "Sources" IS NOT HERE YET.
              The brief asks the footer for "How we handle evidence ·
              Sources · Contribute · About · the language switcher", and
              says "/sources returns 404 today; see section 7."

              Section 7 puts /sources LAST -- it is built from
              `sources` and `claim_citations` and it lands after C4.
              Adding the link before the page exists would put a
              footer link to a 404 on every page of the site. The
              link lands with the page, in lane E3. */}
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .foot-domain {
    color: var(--sub);
    text-decoration: none;
    transition: color 0.14s;
  }
  .foot-domain:hover,
  .foot-domain[data-active='true'] {
    color: var(--accent);
  }

  /* The ACTIVE property must be distinguishable WITHOUT relying on
     colour alone (WCAG 1.4.1). It was distinguished only by its
     colour — terracotta against the footer's warm grey — and the
     colour difference is too small to read as a state.

     The underline is the cue, and it is applied to the ACTIVE one
     only, so the two properties are told apart at a glance and by a
     screen reader that announces the link's state. */
  .foot-domain[data-active='true'] {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
    font-weight: 600;
  }
  .foot-sep {
    color: var(--sub);
    opacity: 0.4;
    margin: 0 2px;
  }
</style>
