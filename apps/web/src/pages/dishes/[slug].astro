---
import AtlasPlaces from "../../components/AtlasPlaces";
import { DishContentSections } from "../../components/DishContentSections";
import { DishDetail } from "../../components/DishDetail";
import type {
  JourneyBeat,
  JourneyLineageLink,
} from "../../components/DishJourney";
import { DishMap } from "../../components/DishMap";
import { EditDishButton } from "../../components/EditDishButton";
import RecipeHub from "../../components/RecipeHub.astro";
import { RelatedDishes } from "../../components/RelatedDishes";
import Layout from "../../layouts/Layout.astro";
import {
  type AtlasResponse,
  getDishAtlas,
  getDishDetail,
  getDishJourney,
  getDishRelations,
  type RelatedDish,
} from "../../lib/api";
import { isGeoDomain } from "../../lib/domain";
import {
  dishUrl,
  hreflangAlternates,
  SITE_LOCALES,
  siteOrigin as siteOriginFor,
} from "../../lib/locales";
import { getHubDishSummaries, getHubRecipes } from "../../lib/recipeHubData";
import type { RecipeSummary } from "../../lib/recipes";
import type { DishDetailResponse } from "../../types/dish";

// MapLibre control + popup CSS — required by <DishMap> and journey path map.
// Not loaded globally (see global.css); this per-route import is paired
// with the matching one in pages/map.astro for <WorldMap>. P2-7.
import "maplibre-gl/dist/maplibre-gl.css";

// ONE ROUTE, TWO VARIANTS — item 5.
//
// ONE SITE
// --------
// There is one site now. `/dishes/<slug>` is ONE page, and it carries
// both halves of the dish:
//
//   the ATLAS half — history, origins, places, families, connections,
//   the journey, the map, the related dishes, the edit button.
//
//   the RECIPE HUB half — the recipes FOR that dish, as its own SECTION
//   on the same page (anchor `#recipes`). Item 5.
//
// ADR-007-A1 §5.3 decided this: the recipe hub for a dish keeps its
// own `/dishes/<slug>` address and is NEVER 301'd away. The cutover
// changed the ADDRESSING, not the CONTENT: the hub is no longer a page
// on a second host, it is a section of the one dish page.
//
// WHY A BRANCH AND NOT TWO FILES
// -------------------------------
// Astro maps one route to one file. `/dishes/<slug>` cannot be two
// files, so the two halves share this one and the build-time branch
// picks which half to render as the page body. The alternative —
// moving the Atlas page to a new path — would change a URL that
// currently ranks, which is not this card's business.
//
// THE BRANCH IS EARLY AND EXPLICIT
// --------------------------------
// The Atlas branch below keeps every one of its own behaviours
// (hreflang, the journey, the map, the related dishes, the edit button).
// The hub branch returns before any of that runs, so the hub page never
// pays for the Atlas's data fetches — and the Atlas page never pays for
// the recipe fetches.
const isGeo = isGeoDomain();

// Generate static paths for every published dish at build time.
// This gives us SSG (HTML pre-rendered, not just SSR-on-request) so crawlers
// and slow clients get a real dish page on first byte, not the SPA fallback.
//
// We use getStaticPaths because Astro 6 default mode is `static` for deployed
// pages; a fully static export also lets us serve everything from the nginx
// container without going back to the API.
/*
  THE API BASE, AT MODULE SCOPE.

  The Recipes block is fetched in BOTH halves of this page: the Atlas
  half fetches the recipes for the dish it is rendering, and the hub
  half fetches the same feed to build its own header. So both need
  the API base.

  It used to be declared INSIDE the `if (!isGeo)` block, so the Atlas
  half -- the one that renders the Recipes block on every dish page --
  referenced an identifier that was not in scope. Every geo dish page
  logged

      ReferenceError: apiBase is not defined

  and fell into the catch, which meant the Recipes block ALWAYS
  rendered its empty state: 854 occurrences across the build, one per
  dish, and the recipes were there the whole time.

  It is now declared once, at module scope, and both halves use it.
*/
const apiBase = import.meta.env.PUBLIC_API_BASE;

export async function getStaticPaths() {
  // The web container only knows how to reach the API via PUBLIC_API_BASE,
  // which during the build step is the absolute https URL.
  // We rely on CI having run the API container + seed before this build runs.
  //
  // The API base is read HERE rather than taken from the module-level
  // constant: Astro evaluates `getStaticPaths` in its own module scope,
  // where that constant is not in scope. Reading the env var in both
  // places gives the same value and no reference error.
  const apiBase = import.meta.env.PUBLIC_API_BASE;
  if (!apiBase) {
    // No API configured at build time — fall back to a placeholder set so
    // the build doesn't fail. The runtime SPA fallback will still recover.
    return [{ params: { slug: "moussaka-greek" } }];
  }

  try {
    // API caps `limit` at 100 per page, so loop to gather all published dishes.
    //
    // The loop runs until the API returns a SHORT page, which is how
    // you know there is no more. It has no upper limit of its own:
    // a cap of 1000 pages' worth of dishes silently dropped every
    // dish past the thousandth, and at 1,474 published dishes that
    // was 474 dishes with no page — a 404 on a dish that exists in
    // the database and is listed in the API.
    const allSlugs: string[] = [];
    const PAGE_SIZE = 100;
    for (let offset = 0; ; offset += PAGE_SIZE) {
      const res = await fetch(
        `${apiBase}/api/dishes?limit=${PAGE_SIZE}&offset=${offset}&status=published`,
      );
      if (!res.ok) throw new Error(`List fetch returned ${res.status}`);
      const json = (await res.json()) as {
        dishes: Array<{ slug: string }>;
      };
      allSlugs.push(...json.dishes.map((d) => d.slug));
      if (json.dishes.length < PAGE_SIZE) break; // last page
      // A guard against a server that keeps returning the same page
      // would loop forever. 500 pages is 50,000 dishes, far past any
      // realistic size, and it stops a bad response from hanging
      // the build.
      if (offset >= 500 * PAGE_SIZE) break;
    }
    return allSlugs.map((slug) => ({ params: { slug } }));
  } catch (err) {
    // Log but don't crash the build. CI will surface the error in logs.
    // eslint-disable-next-line no-console
    console.error("[getStaticPaths] dish list fetch failed:", err);
    return [{ params: { slug: "moussaka-greek" } }];
  }
}

const { slug } = Astro.params;

// ── The hub's data (recipes build only) ─────────────────────────────────
//
// The recipes build needs the dish's HEADER (name, one-line definition,
// cover photo) and its RECIPES. Both come from two paged fetches that
// are memoised across the whole build — see lib/recipeHubData.ts for why
// that matters at 1,474 dishes.
//
// The dish list is the SAME list `getStaticPaths` already fetched, so it
// is fetched once more here and shared by every hub page.
let hubDish: {
  slug: string;
  name: string;
  shortDescription: string | null;
  cover: {
    publicUrl: string | null;
    variantsUrls: Record<string, string>;
    width: number | null;
    height: number | null;
    altText: string | null;
  } | null;
} | null = null;
let hubRecipes: import("../../lib/recipes").RecipeSummary[] = [];
let hubTotal = 0;

if (!isGeo) {
  if (apiBase) {
    // The two fetches are INDEPENDENT and are awaited separately, NOT
    // with `Promise.all`.
    //
    // `Promise.all` rejects as soon as ONE of its promises rejects, and
    // that takes the other result down with it — so a failure in the
    // recipe feed used to erase the dish header that had already been
    // fetched successfully, and every hub rendered "Dish not found"
    // for a dish that is published and present.
    //
    // Both helpers resolve rather than reject (see lib/recipeHubData.ts),
    // so the awaits below cannot throw; the try/catch is the belt to
    // that braces.
    try {
      const dishes = await getHubDishSummaries(apiBase);
      const summary = dishes.get(slug as string);
      if (summary) {
        hubDish = {
          slug: summary.slug,
          name: summary.canonicalName,
          shortDescription: summary.shortDescription,
          cover: summary.cover,
        };
      }

      const byDish = await getHubRecipes(apiBase);
      const list = byDish.get(slug as string) ?? [];
      hubRecipes = list;
      // The TOTAL is the count of published recipes for this dish — the
      // same number the API's hub endpoint reports, derived from the same
      // `recipe_published` rows. It is what the empty state and the
      // `noindex` both depend on.
      hubTotal = list.length;
    } catch (err) {
      // A failed fetch must not fail the build. The hub renders its
      // empty state with the dish's name only, and the reason is logged.
      console.error("[dishes/:slug] hub data fetch failed:", err);
    }
  }
}

// ── The Atlas dish's data (geo build only) ─────────────────────────────
//
// The recipes build does NOT need the Atlas's dish detail, the journey,
// the map or the related dishes — and fetching them for 1,474 hubs would
// double the build time for content the hub must not show anyway
// (ADR-007-A1 §5.1: "No history, places, or families copied from the
// Atlas").
let data: DishDetailResponse | null = null;
let atlasData: AtlasResponse | null = null;
let notFound = false;
let fetchError: string | null = null;
let journeyBeats: JourneyBeat[] = [];
let journeyLineages: JourneyLineageLink[] = [];
// The relations, for the Connections block. `null` means "not fetched",
// which is DIFFERENT from `[]` — an empty array claims the dish has no
// relations, and that is a claim.
let relations: RelatedDish[] | null = null;
// The journey's state: `history`, `gap` or `unavailable`. The History
// section reads it, because "no journey records" and "the journey could
// not be fetched" are different statements.
let journeyStatus: "history" | "gap" | "unavailable" = "gap";
// The published recipes for this dish, for the Recipes block.
//
// The recipe FEED is fetched once for the whole build and grouped by
// dish (lib/recipeHubData.ts), so this costs one request for the build
// rather than one per page. There are zero published recipes today, so
// the list is empty and the block renders its empty state.
let hubRecipesForThisDish: RecipeSummary[] = [];

if (isGeo) {
  try {
    data = await getDishDetail(slug as string);
  } catch (err) {
    // ApiError with status 404 → render our own not-found state.
    // Anything else → show a soft error so the build still succeeds.
    if (
      err &&
      typeof err === "object" &&
      "status" in err &&
      (err as any).status === 404
    ) {
      notFound = true;
    } else {
      fetchError = err instanceof Error ? err.message : String(err);
      notFound = true; // Treat fetch failures as not-found for the user.
    }
  }

  if (data) {
    // Fetch the optional sections together so associations are readable before hydration.
    const [atlas, journey, rel] = await Promise.allSettled([
      getDishAtlas(data.dish.slug),
      getDishJourney(slug as string),
      getDishRelations(data.dish.slug),
    ]);
    if (atlas.status === "fulfilled") atlasData = atlas.value;
    if (journey.status === "fulfilled") {
      journeyBeats = journey.value?.beats ?? [];
      journeyLineages = journey.value?.lineages ?? [];
      journeyStatus = journey.value?.status ?? "gap";
    }
    // A failed relations fetch leaves `relations` null, and the
    // Connections block is then not rendered at all. An empty page is
    // better than a page that says "this dish is not related to
    // anything" because the request failed.
    if (rel.status === "fulfilled") {
      // The API groups the relations by type; the page wants one flat
      // list, and the grouping is re-derived on the client from the
      // relation type itself. Grouping twice would let the two disagree.
      relations = Object.values(rel.value?.relationsByType ?? {}).flat();
    }

    // The recipes for the Recipes block. The feed is memoised for the
    // whole build, so this does not add a request per page.
    try {
      const byDish = await getHubRecipes(apiBase);
      hubRecipesForThisDish = byDish.get(data.dish.slug) ?? [];
    } catch (err) {
      // A failed fetch must not fail the build. The Recipes block then
      // renders its empty state, which is where it starts anyway.
      console.error(
        "[dishes/:slug] the recipe feed fetch failed — the Recipes block will show its empty state:",
        err,
      );
    }
  }

  if (!data && !notFound) notFound = true;
}

// 404 status when slug isn't a real dish. This is the SEO-critical fix:
// previously the SPA fallback returned 200 OK with the home page HTML for
// /dishes/<slug>, which made every bad URL look like the same page to Google.
if (isGeo && notFound) {
  Astro.response.status = 404;
}

// A hub for a dish that is not published is a hub for a page that is not
// on the site — the same 404 the API gives for it.
const hubNotFound = !isGeo && hubDish === null;
if (hubNotFound) {
  Astro.response.status = 404;
}

/**
 * The place associations, in the shape the facts table reads.
 *
 * The facts table wants a place's NAME, the kind of association and the
 * evidence state. The atlas gives the relationship, the name and the
 * evidence status — so this is a rename, not a new claim.
 *
 * Only PLACE entities are used. A community or a practice is not a
 * place, and the row is labelled "Associated with", which means a
 * place.
 */
const atlasPlaces = (atlasData?.placesAndTraditions ?? [])
  .filter((a) => a.entityKind === "place" && a.name)
  .map((a) => ({
    name: a.name as string,
    relationship: a.relationship,
    status: a.evidence?.status,
  }));

const seoTitle = isGeo
  ? data?.dish
    ? `${data.dish.name} — Gustale`
    : "Dish not found — Gustale"
  : hubDish
    ? `${hubDish.name} — recipes — Gustale`
    : "Dish not found — Gustale";

const seoDescription = isGeo
  ? (data?.dish?.description ??
    data?.dish?.shortDescription ??
    "A digital culinary archive.")
  : (hubDish?.shortDescription ??
    `Recipes for ${hubDish?.name ?? "this dish"} on Gustale Recipes.`);

// ── ADR-003: the hreflang alternates ──────────────────────────────────
//
// Reciprocal on every page: `es` points at `en` and `en` points at
// `es`, plus `x-default` pointing at the English URL. The slug is
// stable, so the only thing that changes is the prefix.
//
// The English page is at the ROOT, so the English alternate is the
// un-prefixed URL.
//
// THE HUB IS A SECTION, NOT A SEPARATE PAGE
// -----------------------------------------
// The recipe hub is a SECTION of this page (the `#recipes` anchor), so
// the dish page IS the hub's page. It self-canonicals, and its
// alternates are its OWN locale set — the same set every other page
// on the site declares.
//
// WHY THE ALTERNATES ARE UNCONDITIONAL
// ------------------------------------
// There is one site now, so there is one set of locale URLs for every
// route. The alternates used to be gated on the build variant, because
// the hub used to live on a second host with no translated version of
// its own: that page had no alternates at all, and its `en` alternate
// could not point at the Atlas's dish page, because that would be
// claiming two different pages are translations of one another.
//
// With one site that argument is gone. The dish page declares its
// locale set, on every build, and the hub section inherits the page's
// canonical and its alternates along with it.
// The origin comes from the SHARED helper, not from a second copy of
// the logic.
//
// This line used to be:
//
//     const siteOrigin = import.meta.env.PUBLIC_SITE_ORIGIN ?? "https://gustale.com";
//
// which is a SECOND answer to "what is this site's origin", and it
// was the WRONG one on staging: the helper knows that a staging build
// is the same site on its own host and must not advertise production
// canonicals, but this inline copy skipped that and hard-coded
// gustale.com. The measured effect in the staging build was that the
// dish pages -- the most-linked pages on the site -- carried
// production canonicals and hreflangs while the home page and
// /recipes correctly carried the staging origin.
//
// A page that carries its own canonical is the tell. One helper, one
// answer.
const siteOrigin = siteOriginFor();
const alternates = hreflangAlternates(slug as string, SITE_LOCALES, siteOrigin);
const localeUrls = Object.fromEntries(
  SITE_LOCALES.map((l) => [l, `${siteOrigin}${dishUrl(l, slug as string)}`]),
);

// The English page IS the English one, so it never shows the
// fallback notice. The notice belongs to the locale pages.
const servedEnglish =
  data !== null && data.requestedLocale !== data.locale && data.locale === "en";
---

{
  isGeo ? (
    <Layout
      title={seoTitle}
      description={seoDescription}
      locale="en"
      alternates={alternates}
      localeUrls={localeUrls}
      canonicalUrl={localeUrls["en"]}
    >
      {data ? (
        <>
          {/* Media-first: full-bleed cover + editorial body lead the page.
          Journey mounts inside DishDetail after the hero / before preparation.
          Origin map sits below so the first viewport is image + title, not a widget. */}
          <DishDetail
            dish={data.dish}
            origin={data.origin}
            categories={data.categories}
            tags={data.tags}
            media={data.media}
            unevidenced={data.unevidenced}
                        dimensions={data.dimensions}
            names={data.names}
            places={atlasPlaces}
            preparations={data.preparations}
            hasWhere={atlasPlaces.length > 0 || data.origin !== null}
            hasHistory={true}
            hasConnections={true}
            hasVariants={true}
            hasIngredients={data.ingredients.length > 0}
            hasRecipes={true}
            hasSources={true}
            client:load
          />

          {/* PLACES & TRADITIONS — the typed associations (P4).

          This REPLACES the "Origin" band, which asserted a SETTLED
          origin for a dish whose own journey says the origin is
          contested — falafel's page said "Origin Israel" directly above
          a journey that said Egypt and the Levant. The associations keep
          emergence, tradition, documentation and spread SEPARATE, and
          the legacy value appears under its own heading, marked as
          discovery data.

          The island hydrates near the viewport and can retry when the
          build could not fetch associations. */}
          <div class="wrap">
            {/* ─── Where it belongs (WP-C2) ──────────────────────────────

            The mockup's second section. It groups the two blocks that
            are ABOUT GEOGRAPHY under one heading: the typed place
            associations and the map of the associated place.

            The heading carries the anchor the nav links to
            ("where-heading"). The two blocks keep their own anchors
            for their deep links — the nav does not list them, because
            it would then offer two ways to reach the same geography.

            ONE SECTION, ONE HEADING (D21-2 / the brief's WP-C2b).
            This page used to carry THREE headings about the same
            geography: "Where it belongs", "Places & traditions" (a
            heading inside the island), and "Where Moussaka is
            associated" (the legacy origin band, a whole separate
            section). A reader landing on the page could not tell
            whether these were three facts or one fact stated three
            times.

            The legacy band is now MERGED INTO THIS SECTION: the map
            sits BESIDE the list, under this one heading, so the
            picture and the claims are read together. The legacy value
            keeps its own label inside the island's "Unverified
            associations" group -- where it already lived, with its
            discovery-data warning -- so nothing is lost by merging
            the sections, and the second map and the duplicate heading
            both go.

            The map here is the MAP OF THE ASSOCIATED PLACE, not a
            claim that the dish was invented there. It comes after the
            associations so the reader meets the claims before the
            picture. */}
            <section aria-labelledby="where-heading" class="dish-where">
              <h2 id="where-heading">Where it belongs</h2>
              <p class="sub dish-where__lede">
                The places this dish is associated with, and what kind of
                association each one is.
              </p>
              <AtlasPlaces
                slug={data.dish.slug}
                dishName={data.dish.name}
                initialData={atlasData}
                origin={data.origin}
                client:visible
              />
            </section>
          </div>

          {/* THE CONTENT SECTIONS (WP-C2) — History, Connections, Variants,
          Ingredients + Recipes, Sources. In the blueprint's order.

          They render to STATIC HTML: no `client:` directive, so this
          section ships no JavaScript at all. That is deliberate — a
          section that makes claims about a dish should be the same for
          every reader, and a section that needs no JavaScript cannot be
          half-loaded when a reader arrives.

          The order is the mockup's: Where it belongs (the map above) →
          History → Connections → Variants → Ingredients + Recipes →
          Sources. */}
          <div class="wrap">
            <DishContentSections
              dish={data.dish}
              relations={relations}
              variants={data.variants}
              ingredients={data.ingredients}
              preparations={data.preparations}
              sources={data.sources}
              recipes={hubRecipesForThisDish}
              journeyBeats={journeyBeats}
              journeyStatus={journeyStatus}
              unevidenced={data.unevidenced}
            />
          </div>

          {/* Related dishes — the food-genealogy network. Mounted as its own
          island so the SSR-rendered dish body stays fast and the relations
          load asynchronously without blocking the page. `client:visible`
          defers the fetch until the user scrolls near it. */}
          <div class="wrap" style="padding-bottom: var(--space-8);">
            <RelatedDishes slug={data.dish.slug} client:visible />
          </div>

          {/* Edit button — separate island so it's auth-gated but the rest of
          the dish page remains a static, fast, fully-cached page. */}
          <div class="wrap" style="padding-bottom: var(--space-8);">
            <EditDishButton slug={data.dish.slug} client:load />
          </div>
        </>
      ) : (
        <section class="wrap text-center" style="padding: var(--space-9) 0;">
          <h1 class="page-header">Dish not found</h1>
          <p class="sub">
            We don't have a dish with the slug{" "}
            <code style="background: var(--accent-soft); padding: 2px 6px; border-radius: 4px; font-family: var(--mono); font-size: 14px;">
              {slug}
            </code>
            {fetchError && (
              <span class="block mt-2" style="font-size: 12px; color: var(--sub);">
                {fetchError}
              </span>
            )}
          </p>
          <a href="/dishes" class="btn-accent">
            Browse all dishes
          </a>
        </section>
      )}
    </Layout>
  ) : (
    <Layout
      title={seoTitle}
      description={seoDescription}
      locale="en"
      // ONE SITE, ONE LOCALE SET. The hub is a SECTION of this dish
      // page, so it declares the SAME alternates and the SAME
      // locale URLs the page does — there is no second page on a
      // second host that could own a different set.
      alternates={alternates}
      localeUrls={localeUrls}
      canonicalUrl={localeUrls["en"]}
      // THE DERIVED NOINDEX — ADR-007-A1 §5.2.
      //
      // "It becomes indexable automatically at ≥1 published recipe. The
      // noindex is therefore a derived property, not a stored flag: the
      // hub template emits noindex when the count is zero and omits the
      // meta tag (indexable) when it is ≥1."
      //
      // So this is `total === 0` — the count of PUBLISHED recipes for
      // this dish, read from the same `recipe_published` rows the API's
      // own `empty` flag is derived from. There is no stored flag to
      // drift.
      noindex={hubTotal === 0}
    >
      {hubDish ? (
        <RecipeHub
          dish={{
            slug: hubDish.slug,
            name: hubDish.name,
            shortDescription: hubDish.shortDescription,
          }}
          recipes={hubRecipes}
          total={hubTotal}
          empty={hubTotal === 0}
          cover={hubDish.cover}
        />
      ) : (
        <section class="wrap text-center" style="padding: var(--space-9) 0;">
          <h1 class="page-header">Dish not found</h1>
          <p class="sub">
            We don't have a dish with the slug{" "}
            <code style="background: var(--accent-soft); padding: 2px 6px; border-radius: 4px; font-family: var(--mono); font-size: 14px;">
              {slug}
            </code>
          </p>
          <a href="/dishes" class="btn-accent">
            Browse all recipes
          </a>
        </section>
      )}
    </Layout>
  )
}
