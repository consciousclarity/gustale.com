---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BrowseHeader from "../../components/BrowseHeader.astro";
import { DishExplorer } from "../../components/DishExplorer.tsx";
import ErrorBoundary from "../../components/ErrorBoundary.tsx";
import Layout from "../../layouts/Layout.astro";
import { listDishes } from "../../lib/api";
import { recoveryLinks } from "../../lib/browse";
import { currentDomain, propertyName } from "../../lib/domain";
import type { DishListResponse } from "../../types/dish";

let initial: DishListResponse = {
  dishes: [],
  limit: 24,
  offset: 0,
  total: null,
  hasMore: null,
};
let buildFailed = false;

try {
  initial = await listDishes({ status: "published", limit: 24 });
} catch (err: unknown) {
  buildFailed = true;
  // Keep page useful — no raw API internals in the UI.
  void err;
}

const domain = currentDomain();
const recovery = recoveryLinks(domain);
// PR 2 — the eyebrow must name THIS property, not the other one.
const property = propertyName();
// The number of published dishes that MATCH -- the API's real total,
// not the size of the first page. The old "+" suffix was a guess that
// read as a count and was not one.
const total = initial.total;
const countLabel =
  initial.dishes.length > 0
    ? typeof total === "number"
      ? `${total.toLocaleString("en-US")} ${total === 1 ? "dish" : "dishes"}`
      : // No total from the API: the page length is all we know, and
        // it is a count of what is ON THE PAGE -- not a guess at the
        // whole catalogue. The old code added a "+" here, which read
        // as "at least this many" and was not true either.
        `${initial.dishes.length.toLocaleString("en-US")} ${
          initial.dishes.length === 1 ? "dish" : "dishes"
        }`
    : "Dishes";
---

<Layout title="Dishes — Gustale" description="Browse Gustale dishes and culinary encyclopedia entries.">
  <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: 'Dishes' }]} />

  <BrowseHeader
    eyebrow={property}
    title="Dishes"
    subtitle="Browse dishes by name, country, or family. Load more to keep exploring beyond the first page."
    countLabel={countLabel}
    showToolbar={false}
    showFilters={false}
  />

  {buildFailed && (
    <div class="wrap" style="padding-top: 8px;">
      <div class="browse-banner browse-banner--error" role="status">
        <p>Browse data was unavailable at build time. Live search will retry in the browser.</p>
        <ul class="browse-recovery">
          {recovery.primary.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <section class="wrap browse-page">
    <ErrorBoundary name="Dish list">
      {/* client:load keeps SSR markup for no-JS; avoid a second noscript grid. */}
      <DishExplorer initial={initial} client:load />
    </ErrorBoundary>
  </section>
</Layout>
