---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BrowseHeader from "../components/BrowseHeader.astro";
import ErrorBoundary from "../components/ErrorBoundary.tsx";
import { FamilyDirectory } from "../components/FamilyDirectory.tsx";
import Layout from "../layouts/Layout.astro";
import { buildFamilyDirectory, listAllDishes } from "../lib/browse";

// Let catalogue failures propagate: a short directory must fail the build.
const dishes = await listAllDishes({ status: "published" });
const families = buildFamilyDirectory(dishes);
---

<Layout
  title="Food families — Gustale"
  description="Browse Gustale food families by form, course, content type, and cuisine."
>
  <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: 'Food families' }]} />

  <BrowseHeader
    eyebrow="Browse the atlas"
    title="Food families"
    subtitle="Food families grouped by form, course, content type, and cuisine, with counts and representative dishes."
    countLabel={`${families.length} families`}
    showToolbar={false}
    showFilters={false}
  />

  <section class="wrap browse-page">
    <ErrorBoundary name="Family directory">
      <FamilyDirectory dishes={dishes} client:load />
    </ErrorBoundary>
  </section>
</Layout>
