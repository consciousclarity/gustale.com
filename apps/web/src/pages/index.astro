    border-radius: 999px;
  }

  .home__chip:hover {
    border-color: var(--ink);
  }

  .home__chip-count {
    font-size: 12px;
    font-weight: 600;
    color: var(--sub);
  }

  .home__ingredient-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .home__ingredient-card:hover {
    border-color: var(--ink);
  }

  .home__ingredient-image {
    display: block;
    width: 72px;
    height: 72px;
    flex: none;
    object-fit: cover;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .home__ingredient-image--placeholder {
    background: linear-gradient(135deg, var(--card), #efe7d5);
  }

  .home__ingredient-body {
    display: block;
    min-width: 0;
  }

  .home__ingredient-name {
    display: block;
    margin: 4px 0 var(--space-1);
    font-family: var(--display);
    font-size: 24px;
    color: var(--ink);
  }

  .home__ingredient-dishes {
    display: block;
    font-size: 14px;
    line-height: 1.55;
    color: var(--sub);
  }

  /* ── The legend ──────────────────────────────────────────────────── */

  .home__legend {
    margin-top: var(--space-5);
  }

  .home__legend-intro {
    margin: var(--space-6) 0 var(--space-3);
    font-size: 15px;
    color: var(--ink);
  }

  .home__legend-labels {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home__legend-links {
    margin: var(--space-6) 0 0;
    font-size: 14px;
  }

  .home__legend-links a {
    color: var(--accent);
  }

  /* ── The authoring CTA ──────────────────────────────────────────── */

  .home__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .home__cta-heading {
    margin: 0 0 var(--space-2);
    font-family: var(--display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 400;
    color: var(--ink);
  }

  .home__cta-description {
    margin: 0;
    max-width: 52ch;
    font-size: 15px;
    line-height: 1.6;
    color: var(--sub);
  }

  .home__cta-action {
    text-align: right;
  }

  .home__cta-note {
    margin: var(--space-2) 0 0;
    font-size: 12px;
    color: var(--sub);
  }

  /* ── Narrow screens ──────────────────────────────────────────────── */

  @media (max-width: 1000px) {
    .home__hero {
      grid-template-columns: 1fr;
