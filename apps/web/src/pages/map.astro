---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ErrorBoundary from "../components/ErrorBoundary";
import { WorldMap } from "../components/WorldMap";
import Layout from "../layouts/Layout.astro";
import type { MapDish } from "../lib/api";
import { ApiError, getMapDishes } from "../lib/api";

// MapLibre control + popup CSS — required by <WorldMap> and not loaded
// globally (see global.css). Imported here (not via JS) so it ships with
// the static HTML for the /map route; the bundle's <link rel="stylesheet">
// bypasses any FOUC-on-hydration window. Pinned to match the running JS
// package (5.24.0 in apps/web/package.json). P2-7.
import "maplibre-gl/dist/maplibre-gl.css";

// Server-render the first paint with real dish coordinates so the globe
// has dots from the moment it appears — the React island only adds
// interactivity (hover, click, projection toggle) on hydration.
//
// Note: this fetch runs during CI build (Astro SSG). If it fails, the
// page still ships; WorldMap fetches /api/dishes/map itself on hydration
// when the prop array is empty, so users always see a real globe.
let initialDishes: MapDish[] = [];
let serverError: string | null = null;

try {
  const response = await getMapDishes({ limit: 2000 });
  initialDishes = response.dishes;
} catch (err: unknown) {
  if (err instanceof ApiError) {
    serverError = `API ${err.status} — gustale-api was unreachable during build; the globe will load live data on hydration.`;
  } else if (err instanceof Error) {
    serverError = err.message;
  } else {
    serverError = "Unknown error";
  }
}
---

<Layout
  title="Map — Gustale"
  description="Browse Gustale's dishes on an interactive globe by geographic origin."
>
  <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { href: '/', label: 'Atlas' }, { label: 'Map' }]} />

  <section class="map-page wrap">
    <header>
      <h1 class="map-page h1">
        World map
      </h1>
      <p class="sub">
        Every dish in Gustale has a place of origin. Spin the globe, scroll to
        zoom in on a region, or click a dot to read about the dish behind it.
      </p>
    </header>

    {serverError && (
      <div class="alert alert-warning">
        <strong>Heads up:</strong> the gustale-api could not be reached at build
        time ({serverError}). The globe will load live data on hydration.
      </div>
    )}

    <ErrorBoundary name="Map">
      <WorldMap dishes={initialDishes} client:only="react" />
    </ErrorBoundary>
  </section>
</Layout>