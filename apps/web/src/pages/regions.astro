---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import BrowseHeader from "../components/BrowseHeader.astro";
import { CountryDirectory } from "../components/CountryDirectory.tsx";
import ErrorBoundary from "../components/ErrorBoundary.tsx";
import Layout from "../layouts/Layout.astro";
import { listDishes } from "../lib/api";
import { buildCountryDirectory, recoveryLinks } from "../lib/browse";
import { currentDomain } from "../lib/domain";
import type { DishListResponse } from "../types/dish";

// Route stays /regions; public language is Countries.
let initial: DishListResponse = { dishes: [], limit: 100, offset: 0 };
let buildFailed = false;

try {
  initial = await listDishes({ status: "published", limit: 100 });
} catch {
  buildFailed = true;
}

const domain = currentDomain();
const countries = buildCountryDirectory(initial.dishes);
const recovery = recoveryLinks(domain);
---

<Layout
  title="Countries — Gustale"
  description="Browse Gustale dishes by country of origin — a compact country directory for the atlas."
>
  <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: 'Countries' }]} />

  <BrowseHeader
    eyebrow="Browse the atlas"
    title="Countries"
    subtitle="A compact directory of origins. Search by country or dish name, then follow the dishes into the atlas."
    countLabel={`${countries.length} countries`}
    showToolbar={false}
    showFilters={false}
  />

  {buildFailed && (
    <div class="wrap">
      <div class="browse-banner browse-banner--error" role="status">
        <p>Browse data was unavailable at build time. Retry from the live page when the API recovers.</p>
        <ul class="browse-recovery">
          {recovery.primary.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <section class="wrap browse-page">
    <ErrorBoundary name="Country directory">
      <CountryDirectory dishes={initial.dishes} client:load />
    </ErrorBoundary>
  </section>
</Layout>
