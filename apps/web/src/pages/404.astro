---
import Layout from '../layouts/Layout.astro';
import { GlobalSearch } from '../components/GlobalSearch';
import { recipesUrl } from '../lib/domain';

const isGeo = (import.meta.env.PUBLIC_DOMAIN || 'geo') !== 'recipes';
---

<Layout title="Page not found · Gustale">
  <div class="wrap not-found">
    <p class="eyebrow">{isGeo ? 'Gustale Atlas' : 'Gustale Recipes'}</p>
    <h1>This page isn’t here</h1>
    <p class="lede">
      The link may be outdated, or the dish may have moved. Search the catalog, or jump back into exploration.
    </p>

    <div class="search-slot">
      <GlobalSearch client:load variant="full" placement="drawer" />
    </div>

    <nav class="routes" aria-label="Helpful destinations">
      {
        isGeo ? (
          <>
            <a class="btn-accent" href="/">Return to globe</a>
            <a class="btn-ghost" href="/regions">Explore countries</a>
            <a class="btn-ghost" href="/families">Explore food families</a>
            <a class="btn-ghost" href={recipesUrl('/')}>Gustale Recipes</a>
          </>
        ) : (
          <>
            <a class="btn-accent" href="/">Recipes home</a>
            <a class="btn-ghost" href="/dishes">Browse dishes</a>
            <a class="btn-ghost" href="/families">Explore food families</a>
            <a class="btn-ghost" href="https://gustale.com/">Gustale Atlas</a>
          </>
        )
      }
    </nav>
  </div>
</Layout>

<style>
  .not-found {
    max-width: 40rem;
    padding-block: 3rem 4rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--muted, var(--sub));
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.45rem);
    line-height: 1.15;
  }

  .lede {
    margin: 0 0 1.25rem;
    color: var(--muted, var(--sub));
    line-height: 1.55;
  }

  .search-slot {
    margin-bottom: 1.35rem;
  }

  .routes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
</style>
