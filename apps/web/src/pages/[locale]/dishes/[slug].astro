---
import DishLocalePage from "../../../components/DishLocalePage.astro";
import { applyDishLimit, buildLocales } from "../../../lib/buildScope";
import { type CoreLocale, siteOrigin } from "../../../lib/locales";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE;
  if (!apiBase) {
    return [];
  }

  try {
    const allSlugs: string[] = [];
    const PAGE_SIZE = 100;
    // Until the API returns a SHORT page — that is how you know
    // there is no more. The old cap of 1000 left every dish past
    // the thousandth with no page at all.
    for (let offset = 0; ; offset += PAGE_SIZE) {
      const res = await fetch(
        `${apiBase}/api/dishes?limit=${PAGE_SIZE}&offset=${offset}&status=published`,
      );
      if (!res.ok) throw new Error(`List fetch returned ${res.status}`);
      const json = (await res.json()) as {
        dishes: Array<{ slug: string }>;
      };
      allSlugs.push(...json.dishes.map((d) => d.slug));
      if (json.dishes.length < PAGE_SIZE) break;
      if (offset >= 500 * PAGE_SIZE) break;
    }

    // Only the locales THIS build covers. A scoped build (the staging
    // environment) covers one locale; the production build covers all
    // of them, so `buildLocales()` returns SITE_LOCALES and nothing
    // changes.
    const locales = buildLocales().filter((l) => l !== "en");

    // The same dish limit as the English route, so a scoped build
    // covers the same dishes in every locale it builds.
    const { kept } = applyDishLimit(allSlugs);
    const paths: Array<{
      params: { locale: string; slug: string };
      props: { slug: string; locale: CoreLocale; origin: string };
    }> = [];

    for (const locale of locales) {
      for (const slug of kept) {
        paths.push({
          params: { locale, slug },
          props: { slug, locale, origin: siteOrigin() },
        });
      }
    }
    return paths;
  } catch (err) {
    console.error("[getStaticPaths] locale dish list fetch failed:", err);
    return [];
  }
}

const { slug, locale, origin } = Astro.props as {
  slug: string;
  locale: CoreLocale;
  origin: string;
};
---

<DishLocalePage slug={slug} locale={locale} origin={origin} />
