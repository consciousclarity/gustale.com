---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BrowseHeader from '../components/BrowseHeader.astro';
import { LineageBrowse } from '../components/LineageBrowse.tsx';
import ErrorBoundary from '../components/ErrorBoundary.tsx';
import { listLineages } from '../lib/api';
import { mapBrowseHref, recoveryLinks } from '../lib/browse';
import { currentDomain } from '../lib/domain';
import type { LineageListResponse } from '../types/lineage';

let initial: LineageListResponse = {
  lineages: [],
  totalLineages: 0,
  totalDishes: 0,
  totalRelations: 0,
  uncertainOrParallelCount: 0,
  regions: [],
  techniques: [],
  historicalForces: [],
  confidenceLevels: [],
};
let buildFailed = false;

try {
  initial = await listLineages();
} catch {
  buildFailed = true;
}

const domain = currentDomain();
const recovery = recoveryLinks(domain);
const mapHref = mapBrowseHref(domain);
const sorted = [...initial.lineages].sort((a, b) => a.displayOrder - b.displayOrder);

const CONFIDENCE_LABELS: Record<string, string> = {
  documented: 'Documented',
  likely: 'Likely related',
  probable: 'Probable',
  possible: 'Possible influence',
  uncertain: 'Uncertain',
  parallel_evolution: 'Parallel evolution',
};
---

<Layout
  title="Lineages — Gustale"
  description="Explore how dish ideas travel, split, merge, and reappear across cultures."
>
  <Breadcrumbs crumbs={[{ href: '/', label: 'Home' }, { label: 'Lineages' }]} />

  <BrowseHeader
    eyebrow="Trace the journey"
    title="Lineages"
    subtitle="How dish ideas travel, adapt, and reappear — with honest confidence labels."
    countLabel={`${sorted.length} lineages`}
    showToolbar={false}
    showFilters={false}
  />

  {buildFailed && (
    <div class="wrap">
      <div class="browse-banner browse-banner--error" role="status">
        <p>Browse data was unavailable at build time. Lineage cards below stay available when baked.</p>
        <ul class="browse-recovery">
          {recovery.primary.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  )}

  <section class="wrap browse-page">
    <ErrorBoundary name="Lineage browse">
      <LineageBrowse
        client:load
        lineages={sorted}
        regions={initial.regions}
        techniques={initial.techniques}
        historicalForces={initial.historicalForces}
        confidenceLevels={initial.confidenceLevels}
      />
    </ErrorBoundary>

    <noscript>
      <p class="browse-crosslinks">
        <a href="/families">Food families</a> · <a href={mapHref}>Open the map</a>
      </p>
      <section class="lin-grid">
        {sorted.map((lin) => (
          <article class="lin-card">
            <header class="lin-card__head">
              <span class="lin-card__slug mono-sub">{lin.slug}</span>
              <span class={`lin-card__conf lin-card__conf--${lin.confidenceLevel}`}>
                {CONFIDENCE_LABELS[lin.confidenceLevel] ?? lin.confidenceLevel}
              </span>
            </header>
            <h2 class="lin-card__title">
              <a href={`/lineages/${lin.slug}`}>{lin.name}</a>
            </h2>
            {lin.conceptSummary && <p class="lin-card__concept">{lin.conceptSummary}</p>}
            <a href={`/lineages/${lin.slug}`} class="lin-card__cta">Open the lineage →</a>
          </article>
        ))}
      </section>
    </noscript>
  </section>
</Layout>
