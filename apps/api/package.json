    "@fastify/multipart": "^10.1.4",
    "@fastify/sensible": "^6.0.7",
    "@gustale/db": "workspace:*",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "minio": "^8.0.7",
    "pino-pretty": "^11.3.0",
    "postgres": "^3.4.5",
    "resend": "^6.33.0",
    "zod": "^4.6.7"
