{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/graphify-out",
      "!packages/db/drizzle",
      "!data",
      // The two mock files are GENERATED ARTEFACTS. The capture script
      // (scripts/refresh-ss-mock.mjs) writes them, and biome's JSON
      // formatter disagrees with JSON.stringify's output — so every
      // capture reintroduced a lint failure.
      //
      // They are build INPUTS, not source: the Astro build bakes
      // against them, and apps/api/test/mock-data.test.ts is what
      // actually validates them — a stronger check than a formatter.
      "!apps/web/scripts/mock-api-data.json",
      "!apps/web/scripts/mock-api-lineages.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      // TODO(biome): ratchet these parked rules back to "error" once debt is cleaned.
      // Kept at "warn" so the first Biome CI gate stays green (non-breaking).
      "a11y": {
        "noStaticElementInteractions": "warn",
        "noSvgWithoutTitle": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useButtonType": "warn",
        "useGenericFontNames": "warn",
        "useKeyWithClickEvents": "warn",
        "useSemanticElements": "warn",
        "useValidAnchor": "warn"
      },
      "correctness": {
        "noUnknownTypeSelector": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noAssignInExpressions": "warn",
        "noShadowRestrictedNames": "warn",
        "useIterableCallbackReturn": "warn"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
