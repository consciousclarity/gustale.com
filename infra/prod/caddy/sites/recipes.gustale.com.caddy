# recipes.gustale.com -- REDIRECT ONLY (PR 2 of the single-domain cutover)
#
# WHAT THIS IS
# ------------
# After the cutover, gustale.com is the ONLY domain. This host, and
# its siblings (gustale.recipes, www.gustale.recipes), exist only to
# send a 301 to the right place on gustale.com.
#
# WHAT CHANGED HERE
# -----------------
# Until the cutover this file SERVED the recipes site -- a copy of the
# gustale.recipes vhost with an X-Robots-Tag: noindex header, so that
# Google would see two doors onto the same content and index only one.
#
# A 301 does that job better than a noindex does:
#
#   * a noindex says "do not list this page, but send the reader
#     here", so the canonical host keeps its old ranking and the
#     duplicate still competes with it;
#   * a 301 says "this URL has MOVED", which is the truth after the
#     cutover, and transfers the ranking to the new URL.
#
# So the noindex block is DELETED, not edited, and the host becomes a
# redirect.
#
# WHY THE RULES ARE A SEPARATE COPY
# ---------------------------------
# Caddy refuses to start when two imported files declare the same
# host, and the VPS keeps one file per vhost in /etc/caddy/sites/ and
# imports them by name. So the three redirect hosts have three files.
#
# The rules below are IDENTICAL to the ones in gustale.recipes.caddy.
# They are kept in step by `scripts/verify-redirect-rules.sh`, which
# exercises all three files against a real Caddy and fails if they
# diverge. A copy that is only kept in step by a test is still a copy,
# and this comment says so rather than pretending otherwise.
#
# WHEN THIS FILE IS INSTALLED
# ----------------------------
# ONLY AFTER PR 1 IS LIVE AND VERIFIED. Until gustale.com serves
# /recipes and /ingredients, a redirect to it sends readers to a 404.
# The order is: PR1 live -> PR2 live -> remove the recipes web
# container and its CI matrix entry.
#
# EVERY RULE HERE WAS VERIFIED AGAINST A REAL CADDY
# --------------------------------------------------
# Caddy v2.11.9, run locally, with the Location headers read back.
# Three bugs were found and fixed that way, and they are the reason
# the comments below are as long as they are. Do not "simplify" this
# file without re-running the test in
# docs/REDIRECTS-single-domain.md.
#
#   1. `redir` is NOT A MATCHER. It is a terminal handler that always
#      fires. Several `redir` directives in one site block means the
#      FIRST one answers EVERY request.
#
#   2. `redir` does NOT expand regexp captures. `{http.regexp.1}`
#      comes out LITERALLY in the Location header.
#
#   3. `{uri}` ALREADY CONTAINS THE QUERY STRING. Appending {?query}
#      to it DOUBLES the query.
#
# ONE HOP
# -------
# Every target is on gustale.com, which does not redirect. No rule
# points at another redirect host, so there is never a chain.

recipes.gustale.com {
	# ═══ /api/* — PROXY, DO NOT REDIRECT ═════════════════════════
	#
	# A 301 on /api/* would break every POST. The browser follows a
	# 301 on a POST by re-issuing it as a GET (or not at all), and
	# every write -- a login, a dish edit, a publish -- would be lost.
	# So the API keeps being proxied here for 90 days, while the
	# PUBLIC pages move.
	#
	# It is the SAME upstream the recipes host serves today, on the
	# SAME port, so this is a continuation rather than a change: the
	# API is one container for both domains and always has been.
	#
	# REMOVAL DATE: 2027-02-14 (90 days after the cutover).
	handle /api/* {
		reverse_proxy 127.0.0.1:4000
	}

	# ═══ /media/* — PROXY, DO NOT REDIRECT ═══════════════════════
	#
	# The same reason as /api/*: a cover image is fetched by an <img>
	# tag, and a 301 there is a wasted round trip on every image on
	# every page. The bucket name is hard-coded and the URI rewrite
	# maps /media/<key> to /gustale-public/<key>, exactly as it does
	# on gustale.com.
	#
	# REMOVAL DATE: 2027-02-14.
	@media_read {
		path /media/*
		method GET HEAD
	}
	handle @media_read {
		uri replace /media/ /gustale-public/ 1
		reverse_proxy 127.0.0.1:9000
		header Cache-Control "public, max-age=31536000, immutable"
	}
	# Anything else under /media (listing, writes) -> 404, as today.
	@media_other path /media /media/ /media/*
	handle @media_other {
		respond 404
	}

	# ═══ THE REDIRECTS — most specific first ═════════════════════
	#
	# The order matters and it is enforced by the matchers being
	# mutually exclusive, not by their order alone. Caddy evaluates
	# the named matchers in the order they are DEFINED, and the
	# `handle` blocks in the order they are written, so the specific
	# rules are first and the catch-all is last.

	# /recipes/<slug>  ->  https://gustale.com/recipes/<slug>
	#
	# This MUST be before the /recipes rule, or a recipe page would
	# land on the bare hub.
	#
	# The `not path /recipes/` matters: `path /recipes/*` also matches
	# the trailing-slash form with an EMPTY capture, and that form
	# belongs to the root rule below.
	@recipe_slug {
		path /recipes/*
		not path /recipes/
	}
	handle @recipe_slug {
		rewrite * /recipes/{re.slug}
		redir https://gustale.com{uri} permanent
	}

	# /dishes/<slug>  ->  https://gustale.com/dishes/<slug>#recipes
	#
	# The fragment goes in the Location header. A browser drops the
	# fragment when it follows the redirect, and lands on the Recipes
	# block of the dish page -- which is where the per-dish hub's
	# content lives after the cutover.
	#
	# "/dishes/new" is EXCLUDED: it is an authoring route, not a dish
	# page, and it maps to the same path -- not to a dish page with a
	# #recipes fragment.
	@dish_slug {
		path /dishes/*
		not path /dishes/new
		not path /dishes/new/
	}
	handle @dish_slug {
		rewrite * /dishes/{re.slug}
		redir https://gustale.com{uri}#recipes permanent
	}

	# / and /recipes and /recipes/  ->  https://gustale.com/recipes
	#
	# {?query} IS NEEDED HERE and only here: the target is a LITERAL
	# path, so Caddy has no {uri} to carry the query. Everywhere else
	# the target is {uri}, which already contains it.
	@recipes_root path / /recipes /recipes/
	handle @recipes_root {
		redir https://gustale.com/recipes{?query} permanent
	}

	# EVERYTHING ELSE  ->  the same path on gustale.com
	#
	# {uri} is the path AND the query string. The target host does not
	# redirect, so this is always the last hop.
	handle {
		redir https://gustale.com{uri} permanent
	}

	# The redirect responses themselves carry no cache. A cached 301
	# is a 301 that cannot be fixed without a cache bust.
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/gustale.recipes.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}
