+      # ── 0055: the sourcing availability tables and columns ──────────
+      #
+      # ADR-008's data model (GUS-1102). Three tables --
+      # ingredient_availability, ingredient_substitutes,
+      # recipe_ingredient_substitutes -- and four columns:
+      # recipe_ingredients.is_key / accepted_forms / cost_weight, and
+      # ingredients.ubiquitous.
+      #
+      # It runs AFTER 0052 (the recipes schema), because
+      # recipe_ingredient_substitutes references recipe_ingredients.
+      # It is strictly additive: every new column has a DEFAULT, every
+      # new table starts empty. It writes no content rows, and its
+      # proof runs inside its own transaction.
+      - name: Apply the sourcing availability tables
+        run: |
+          PGPASSWORD=gustale psql -h 127.0.0.1 -U postgres -d gustale_ci -v ON_ERROR_STOP=1 \
+            -f db/migrations/0055_sourcing_availability.sql 2>&1 | tee /tmp/m0055.log
+          bash scripts/check-ci-markers.sh "the sourcing availability tables" "INGREDIENT_SOURCING_AVAILABILITY_OK" /tmp/m0055.log
