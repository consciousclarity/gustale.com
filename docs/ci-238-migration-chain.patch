# PR #236's ci.yml patch — PR #232's patch MUST be applied FIRST.
#
# WHY THE ORDER MATTERS
# ---------------------
# PR #232's patch and this one both touch the deploy's "Real verify" step
# and the lint job, and both proposed a "served SHA" check there. Applied
# one after the other with `git apply`, the SECOND patch uses the FIRST
# patch's hunk CONTEXT to decide what to replace -- and that context is
# the first patch's newly-added text. So #232's patch would silently
# CONSUME parts of this one (it does: the served-SHA block, the
# migration lines, and the contract-test step all disappear).
#
# So they are applied in this order:
#
#   1. #232's patch  (docs/ci-patches/ci-workflow-dispatch-and-served-sha.patch)
#   2. THIS patch    (docs/ci-238-migration-chain.patch)
#
# ...and the result is the ci.yml that both PRs intend.
#
# WHO OWNS THE SERVED-SHA CHECK
# -----------------------------
# #232 owns it, as "Check 2b". It is the better implementation: it sits
# immediately after the container-image check it complements, reads
# /health over the PUBLIC hostname (so it exercises the path a visitor
# actually takes), and extracts the SHA with `sed` -- no `jq` on the
# deploy box.
#
# This patch therefore does NOT add a served-SHA check. It adds the
# PER-CONTAINER check, which is a different thing: it asks each web
# container's image tag whether it carries this run's SHA. That is the
# per-container form of the split-brain check -- the one that would have
# caught the 2026-11-13 half-deployed state, where the API was on the
# new SHA and both web containers were on the old one for 23 hours.
#
# WHAT THIS PATCH ADDS
# ---------------------
#   * the two new migrations (gus-238b, gus-238c), placed AFTER 0040,
#     where their dependencies exist;
#   * the corrected tag-file assertions -- real commands, not `:?`
#     parameter expansions, which do not fire the ERR trap and let a
#     failed deploy report success;
#   * the fixed EXIT trap;
#   * the deploy tag-file contract test step;
#   * the per-container SHA check (Check 3).
#
# The App has no `workflows` scope, so this ships as a patch file for the
# owner to apply.

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index c3c5d9e..144053e 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -280,6 +280,31 @@ jobs:
       - name: Test the CI marker checker
         run: bash scripts/test-check-ci-markers.sh
 
+      # The deploy's tag-file contract, and its exit-code contract.
+      #
+      # On 2026-11-13 the deploy of PR #234 reported SUCCESS for a deploy
+      # that had swapped the API, died, and left the web containers on the
+      # previous SHA. Its log held exactly one line -- `DEPLOY_EXIT_CODE=0`
+      # -- and the site was half-deployed for 23 hours.
+      #
+      # Two bugs, both needed:
+      #
+      #   1. build-web-live.sh wrote the tag file AFTER the builds, so a
+      #      failed build left a ZERO-BYTE file, and `source` on an empty
+      #      file exports nothing.
+      #   2. The EXIT trap did `exit "$_DEPLOY_EXIT"`, and `_DEPLOY_EXIT`
+      #      was only set by the ERR trap -- which does NOT fire on a `:?`
+      #      parameter expansion or on an explicit `exit 1`. So the trap
+      #      REPLACED the intended exit code with 0.
+      #
+      # A test that only proves the success path would pass against the
+      # broken code, so this one drives a REAL failing build and asserts
+      # the failure is visible: a non-empty tag file, a non-zero exit, a
+      # DEPLOY_FAILED_AT line, and a log that does NOT say
+      # DEPLOY_EXIT_CODE=0.
+      - name: Test the deploy tag-file and exit-code contract
+        run: bash scripts/test-deploy-tag-file.sh
+
       # The lint wrapper's own test.
       #
       # `biome check --no-errors-on-unmatched` can exit 0 while having
@@ -927,6 +952,24 @@ jobs:
           PGPASSWORD=gustale psql -h 127.0.0.1 -U postgres -d gustale_ci -v ON_ERROR_STOP=1 \
             -f db/migrations/0040_atlas_publication_predicate.sql
 
+      # 238b and 238c come AFTER 0040, and NOT in the gus_files list
+      # above.
+      #
+      # 238b replaces the function 0040 creates
+      # (`published_associations_for_dish`) and references the table
+      # 0036 creates (`dish_place_associations`). In the gus_files list
+      # -- which runs BEFORE 0036 and 0040 -- it failed with:
+      #
+      #     ERROR:  type "dish_place_associations" does not exist
+      #
+      # So it belongs here, where its dependencies exist.
+      - name: Apply the association review visibility and the GUS-238 ledger
+        run: |
+          PGPASSWORD=gustale psql -h 127.0.0.1 -U postgres -d gustale_ci -v ON_ERROR_STOP=1 \
+            -f db/migrations/gus-238b-association-review-visibility.sql
+          PGPASSWORD=gustale psql -h 127.0.0.1 -U postgres -d gustale_ci -v ON_ERROR_STOP=1 \
+            -f db/migrations/gus-238c-constraint-idempotence-and-ledger.sql
+
       # 0041 is the ROLE SEPARATION for the publish credential.
       #
       # 0038's guard checked that the credential's ACCOUNT is real. It
@@ -1549,8 +1592,49 @@ jobs:
               DEPLOY_LOG="/tmp/gustale-deploy-${GITHUB_RUN_ID}.log"
               : > "$DEPLOY_LOG"
               _DEPLOY_EXIT=0
-              trap '_LAST_CMD=${BASH_COMMAND}; rc=$?; if [ $rc -ne 0 ] && [ "$_DEPLOY_EXIT" = "0" ]; then _DEPLOY_EXIT=$rc; echo "DEPLOY_FAILED_AT=${_LAST_CMD} (rc=$rc)" >> "$DEPLOY_LOG"; fi' ERR
-              trap 'echo "DEPLOY_EXIT_CODE=${_DEPLOY_EXIT}" >> "$DEPLOY_LOG"; exit "$_DEPLOY_EXIT"' EXIT
+              # THE ERR TRAP AND THE EXIT TRAP
+              # --------------------------------
+              # The ERR trap catches a command that returns non-zero. The
+              # EXIT trap writes the final code.
+              #
+              # BOTH WERE WRONG BEFORE 2026-11-14, in a way that made a
+              # failed deploy report success.
+              #
+              # 1. The EXIT trap did `exit "$_DEPLOY_EXIT"`. But
+              #    `_DEPLOY_EXIT` is only set by the ERR trap, and the
+              #    ERR trap does NOT fire on:
+              #       * a `:?` parameter expansion,
+              #       * an explicit `exit 1`.
+              #    So a script that reached `exit 1` still ended with
+              #    `_DEPLOY_EXIT=0`, and the EXIT trap REPLACED the
+              #    intended exit code with 0.
+              #
+              #    Verified: run 43429059289's log was 19 bytes and held
+              #    exactly one line -- `DEPLOY_EXIT_CODE=0` -- for a
+              #    deploy that had swapped the API, died, and left the
+              #    web containers on the previous SHA.
+              #
+              # 2. The ERR trap's own condition was fragile: it only
+              #    recorded the FIRST failure, and only when
+              #    `_DEPLOY_EXIT` was still 0.
+              #
+              # THE FIX
+              # --------
+              # The EXIT trap now uses the status the script is EXITING
+              # with, and only falls back to `_DEPLOY_EXIT`:
+              #
+              #     trap 'rc=$?; ...; exit "${rc}"' EXIT
+              #
+              # `$?` inside the EXIT trap is the script's exit status.
+              # So an `exit 1` is now reported as 1, a `set -e`
+              # failure is reported as its own status, and the ERR trap
+              # still adds the `DEPLOY_FAILED_AT=` line.
+              #
+              # The ERR trap is also widened to record the failure
+              # REGARDLESS of `_DEPLOY_EXIT`, so a second failure is
+              # never swallowed.
+              trap '_LAST_CMD=${BASH_COMMAND}; rc=$?; if [ $rc -ne 0 ]; then echo "DEPLOY_FAILED_AT=${_LAST_CMD} (rc=$rc)" >> "$DEPLOY_LOG"; _DEPLOY_EXIT=$rc; fi' ERR
+              trap 'rc=$?; if [ "$rc" != "0" ]; then _DEPLOY_EXIT=$rc; fi; echo "DEPLOY_EXIT_CODE=${_DEPLOY_EXIT}" >> "$DEPLOY_LOG"; exit "${_DEPLOY_EXIT}"' EXIT
 
               # --- Deploy lock ------------------------------------------------
               # A VPS-side lock, so that two deploys can never interleave
@@ -1733,10 +1817,49 @@ jobs:
               }
 
               # The script writes TAG / IMAGE_RECIPES / IMAGE_GEO to $TAG_FILE.
+              #
+              # build-web-live.sh now writes that file BEFORE the builds, so
+              # a failed build still leaves a VALID file. But the file is
+              # read here, so the read must be defensive: an empty or
+              # missing file means the build died before it could write
+              # one, and that must ABORT THE DEPLOY, not continue.
+              #
+              # THE 2026-11-13 FAILURE, AND WHY THIS ASSERTION IS NOT A
+              # `:?` EXPANSION
+              # -------------------------------------------
+              # These two lines used to be:
+              #
+              #     : "${IMAGE_RECIPES:?build-web-live.sh did not write IMAGE_RECIPES}"
+              #     : "${IMAGE_GEO:?build-web-live.sh did not write IMAGE_GEO}"
+              #
+              # and the deploy died with `DEPLOY_EXIT_CODE=0` in its log
+              # and a 19-byte log file -- for a deploy that had swapped
+              # the API and left the web containers on the previous SHA.
+              #
+              # A `:?` parameter expansion is NOT A COMMAND. The ERR trap
+              # does not fire on it, it does not set a non-zero exit
+              # status, and the script CONTINUES and exits 0. So the
+              # failure was invisible to every check the deploy had.
+              #
+              # The assertions below are REAL COMMANDS (`test -n`), which
+              # fire the ERR trap, set a non-zero status, and abort.
+              if [ ! -s "$TAG_FILE" ]; then
+                echo "::error::the tag file $TAG_FILE is missing or EMPTY -- the web build died before it could write it"
+                echo "DEPLOY_FAILED_AT=tag file missing or empty" >> "$DEPLOY_LOG"
+                exit 1
+              fi
               # shellcheck disable=SC1090
               source "$TAG_FILE"
-              : "${IMAGE_RECIPES:?build-web-live.sh did not write IMAGE_RECIPES}"
-              : "${IMAGE_GEO:?build-web-live.sh did not write IMAGE_GEO}"
+              if [ -z "${IMAGE_RECIPES:-}" ]; then
+                echo "::error::the tag file has no IMAGE_RECIPES -- build-web-live.sh did not write it"
+                echo "DEPLOY_FAILED_AT=tag file has no IMAGE_RECIPES" >> "$DEPLOY_LOG"
+                exit 1
+              fi
+              if [ -z "${IMAGE_GEO:-}" ]; then
+                echo "::error::the tag file has no IMAGE_GEO -- build-web-live.sh did not write it"
+                echo "DEPLOY_FAILED_AT=tag file has no IMAGE_GEO" >> "$DEPLOY_LOG"
+                exit 1
+              fi
 
               # The tag the script wrote MUST be the tag this run asked
               # for. A mismatch means the deploy read a stale file, which
@@ -1997,6 +2120,44 @@ jobs:
                 FAILED=1
               fi
 
+              # --- Check 3: every web container serves this run's SHA ---
+              # Check 2 proves what each container was STARTED with, and
+              # Check 2b proves what the API is SERVING. Neither says
+              # anything about the WEB containers' own images.
+              #
+              # gustale.com and gustale.recipes are TWO SEPARATE sites,
+              # served by TWO SEPARATE containers, built INDEPENDENTLY.
+              # A container can be on the right image and still be
+              # serving a stale build -- which is exactly the
+              # half-deployed state of 2026-11-13, where the API was on
+              # the new SHA and both web containers were on the old one,
+              # for 23 hours, with the deploy log saying DEPLOY_EXIT_CODE=0.
+              #
+              # The image tag carries the short SHA, so this is the
+              # per-container form of the split-brain check that the
+              # sitemap comparison does by count.
+              echo ""
+              echo "--- Check 3: every web container serves this run's SHA ---"
+              for NAME in gustale-web-recipes gustale-web-geo; do
+                if ! docker inspect "$NAME" >/dev/null 2>&1; then
+                  echo "::error::Container $NAME is missing"
+                  FAILED=1
+                  continue
+                fi
+                IMAGE=$(docker inspect --format='{{.Config.Image}}' "$NAME" 2>/dev/null)
+                case "$IMAGE" in
+                  *"live-data-${SHORT_SHA}-"*)
+                    echo "  $NAME: $IMAGE  OK"
+                    ;;
+                  *)
+                    echo "::error::$NAME is serving $IMAGE -- expected a live-data-${SHORT_SHA}-* image"
+                    echo "::error::$NAME expected tag: live-data-${SHORT_SHA}-*"
+                    echo "::error::$NAME actual   tag: ${IMAGE##*:}"
+                    FAILED=1
+                    ;;
+                esac
+              done
+
               # --- Check 4: BOTH domains serve the expected sitemap ---
               # gustale.com and gustale.recipes are TWO SEPARATE sites,
               # served by TWO SEPARATE containers, built and deployed
