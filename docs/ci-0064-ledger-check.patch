+  # ─── The live ledger check ────────────────────────────────────────────
+  #
+  # `scripts/check-live-ledger.py` compares the migration FILES against
+  # the live ledger in BOTH directions: every file has exactly one row
+  # with the same number and checksum, and every row has exactly one
+  # file.
+  #
+  # It runs on the VPS, where the live database and the checkout of the
+  # migration files both live. It is READ-ONLY -- one SELECT.
+  #
+  # WITHOUT THIS, a migration applied to live and a migration file in
+  # the repository can drift apart silently. That is exactly what
+  # happened to 0062 and 0063, for eight days.
+  ledger-check:
+    name: Live ledger check
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ github.sha }}
+
+      - name: The live ledger check
+        env:
+          GUSTALE_LIVE_HOST: root@62.72.7.218
+        run: |
+          python3 scripts/check-live-ledger.py --live
+
   # ─── Production image build verification ────────────────────────────
   build-prod:
     name: Build production image
