@@ -291,6 +291,71 @@ jobs:
             --data-urlencode "text=${MSG}" \\
             --max-time 10 || echo "::warning::Telegram notification failed (non-fatal)"
 
+  # ─── The live ledger check ───────────────────────────────────────────
+  #
+  # `public.gus_migrations_applied` is the ledger of what has actually
+  # been applied to the LIVE database. This job compares it against the
+  # migration files, in BOTH directions:
+  #
+  #   * every migration file has exactly one ledger row, with the same
+  #     number and the same checksum;
+  #   * every ledger row has exactly one migration file.
+  #
+  # WHY IT IS A NIGHTLY AND NOT A PULL REQUEST CHECK
+  # ------------------------------------------------
+  # It reads the LIVE database, so it cannot run on a pull request --
+  # there is nothing on a runner that knows what live looks like, and
+  # giving CI a live credential would put production one mistake away.
+  #
+  # WHY IT RUNS ON THE VPS
+  # ----------------------
+  # It runs on the VPS over SSH, where the live database is and where
+  # the git checkout of the migration files lives. It uses the same
+  # `appleboy/ssh-action` mechanism as the re-translation job above, so
+  # there is one way to reach the VPS, not two.
+  #
+  # WHAT IT CAUGHT
+  # --------------
+  # On 2026-11-20 it found that the live ledger was missing the rows
+  # for 0062 and 0063 -- the ledger table was created by 0060, so the
+  # two migrations applied after it had not recorded themselves -- and
+  # that the 0054 row's name did not match its file's name. Migration
+  # 0064 repaired all of it.
+  ledger-check:
+    name: Live ledger check
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+
+    steps:
+      - name: Check the live ledger against the migration files
+        uses: appleboy/ssh-action@v1
+        with:
+          host: ${{ secrets.HOSTINGER_HOST }}
+          username: ${{ secrets.HOSTINGER_USER }}
+          key: ${{ secrets.HOSTINGER_SSH_KEY }}
+          command_timeout: 5m
+          script: |
+            set -euo pipefail
+            BUILD_DIR="${{ vars.GUSTALE_BUILD_DIR || '/home/deploy/gustale-build' }}"
+            SHA="${{ github.sha }}"
+
+            if [ ! -d "$BUILD_DIR/.git" ]; then
+              echo "::error::no git checkout at $BUILD_DIR"
+              exit 1
+            fi
+
+            git config --global --add safe.directory "$BUILD_DIR" 2>/dev/null || true
+            git -C "$BUILD_DIR" fetch --no-tags --depth=50 origin "$SHA"
+            git -C "$BUILD_DIR" checkout --quiet --force "$SHA"
+
+            cd "$BUILD_DIR"
+
+            # The check is run HERE, on the VPS, so it reads the live
+            # container directly -- `--container`, not `--live`. `--live`
+            # would SSH to the VPS from the VPS, which needs a key the
+            # VPS does not have for itself.
+            python3 scripts/check-live-ledger.py --container
+
   # ─── Production image build verification ────────────────────────────
   build-prod:
     name: Build production image
